root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= string
node-3 ::= integer
node-1-0 ::= "state" ws "=" ws node-2 node-1-1 | "year" ws "=" ws node-3 node-1-2
node-1-1 ::= ws "," ws "year" ws "=" ws node-3 node-1-3
node-1-2 ::= ws "," ws "state" ws "=" ws node-2 node-1-3
node-1-3 ::= ""
node-5 ::= string
node-6 ::= integer
node-7 ::= "'Real'" | "'Nominal'"
node-4-0 ::= "state" ws "=" ws node-5 node-4-1 | "year" ws "=" ws node-6 node-4-2 | "adjustment" ws "=" ws node-7 node-4-4
node-4-1 ::= ws "," ws "year" ws "=" ws node-6 node-4-3 | ws "," ws "adjustment" ws "=" ws node-7 node-4-5
node-4-2 ::= ws "," ws "state" ws "=" ws node-5 node-4-3 | ws "," ws "adjustment" ws "=" ws node-7 node-4-6
node-4-3 ::= "" | ws "," ws "adjustment" ws "=" ws node-7 node-4-7
node-4-4 ::= ws "," ws "state" ws "=" ws node-5 node-4-5 | ws "," ws "year" ws "=" ws node-6 node-4-6
node-4-5 ::= ws "," ws "year" ws "=" ws node-6 node-4-7
node-4-6 ::= ws "," ws "state" ws "=" ws node-5 node-4-7
node-4-7 ::= ""
call ::= ("us_history.population_by_state_year" ws "(" ws node-1-0 ws ")") | ("us_economy.gdp_by_state_year" ws "(" ws node-4-0 ws ")")
