node-6-11 ::= ws "," ws "time" ws "=" ws node-9 node-6-15
node-6-12 ::= ws "," ws "initial_speed" ws "=" ws node-7 node-6-13 | ws "," ws "acceleration" ws "=" ws node-8 node-6-14
