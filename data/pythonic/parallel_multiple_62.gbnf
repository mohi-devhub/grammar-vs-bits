root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= number
node-3 ::= number
node-4 ::= number
node-5 ::= integer
node-1-0 ::= "initial_speed" ws "=" ws node-2 node-1-1 | "acceleration" ws "=" ws node-3 node-1-2 | "time" ws "=" ws node-4 node-1-4 | "rounding" ws "=" ws node-5 node-1-8
node-1-1 ::= ws "," ws "acceleration" ws "=" ws node-3 node-1-3 | ws "," ws "time" ws "=" ws node-4 node-1-5 | ws "," ws "rounding" ws "=" ws node-5 node-1-9
node-1-2 ::= ws "," ws "initial_speed" ws "=" ws node-2 node-1-3 | ws "," ws "time" ws "=" ws node-4 node-1-6 | ws "," ws "rounding" ws "=" ws node-5 node-1-10
node-1-3 ::= ws "," ws "time" ws "=" ws node-4 node-1-7 | ws "," ws "rounding" ws "=" ws node-5 node-1-11
node-1-4 ::= ws "," ws "initial_speed" ws "=" ws node-2 node-1-5 | ws "," ws "acceleration" ws "=" ws node-3 node-1-6 | ws "," ws "rounding" ws "=" ws node-5 node-1-12
node-1-5 ::= ws "," ws "acceleration" ws "=" ws node-3 node-1-7 | ws "," ws "rounding" ws "=" ws node-5 node-1-13
node-1-6 ::= ws "," ws "initial_speed" ws "=" ws node-2 node-1-7 | ws "," ws "rounding" ws "=" ws node-5 node-1-14
node-1-7 ::= "" | ws "," ws "rounding" ws "=" ws node-5 node-1-15
node-1-8 ::= ws "," ws "initial_speed" ws "=" ws node-2 node-1-9 | ws "," ws "acceleration" ws "=" ws node-3 node-1-10 | ws "," ws "time" ws "=" ws node-4 node-1-12
node-1-9 ::= ws "," ws "acceleration" ws "=" ws node-3 node-1-11 | ws "," ws "time" ws "=" ws node-4 node-1-13
node-1-10 ::= ws "," ws "initial_speed" ws "=" ws node-2 node-1-11 | ws "," ws "time" ws "=" ws node-4 node-1-14
node-1-11 ::= ws "," ws "time" ws "=" ws node-4 node-1-15
node-1-12 ::= ws "," ws "initial_speed" ws "=" ws node-2 node-1-13 | ws "," ws "acceleration" ws "=" ws node-3 node-1-14
node-1-13 ::= ws "," ws "acceleration" ws "=" ws node-3 node-1-15
node-1-14 ::= ws "," ws "initial_speed" ws "=" ws node-2 node-1-15
node-1-15 ::= ""
node-7 ::= number
node-8 ::= number
node-9 ::= number
node-10 ::= integer
node-6-0 ::= "initial_speed" ws "=" ws node-7 node-6-1 | "acceleration" ws "=" ws node-8 node-6-2 | "time" ws "=" ws node-9 node-6-4 | "rounding" ws "=" ws node-10 node-6-8
node-6-1 ::= ws "," ws "acceleration" ws "=" ws node-8 node-6-3 | ws "," ws "time" ws "=" ws node-9 node-6-5 | ws "," ws "rounding" ws "=" ws node-10 node-6-9
node-6-2 ::= ws "," ws "initial_speed" ws "=" ws node-7 node-6-3 | ws "," ws "time" ws "=" ws node-9 node-6-6 | ws "," ws "rounding" ws "=" ws node-10 node-6-10
node-6-3 ::= ws "," ws "time" ws "=" ws node-9 node-6-7 | ws "," ws "rounding" ws "=" ws node-10 node-6-11
node-6-4 ::= ws "," ws "initial_speed" ws "=" ws node-7 node-6-5 | ws "," ws "acceleration" ws "=" ws node-8 node-6-6 | ws "," ws "rounding" ws "=" ws node-10 node-6-12
node-6-5 ::= ws "," ws "acceleration" ws "=" ws node-8 node-6-7 | ws "," ws "rounding" ws "=" ws node-10 node-6-13
node-6-6 ::= ws "," ws "initial_speed" ws "=" ws node-7 node-6-7 | ws "," ws "rounding" ws "=" ws node-10 node-6-14
node-6-7 ::= "" | ws "," ws "rounding" ws "=" ws node-10 node-6-15
node-6-8 ::= ws "," ws "initial_speed" ws "=" ws node-7 node-6-9 | ws "," ws "acceleration" ws "=" ws node-8 node-6-10 | ws "," ws "time" ws "=" ws node-9 node-6-12
node-6-9 ::= ws "," ws "acceleration" ws "=" ws node-8 node-6-11 | ws "," ws "time" ws "=" ws node-9 node-6-13
