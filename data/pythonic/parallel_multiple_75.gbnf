root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= string
node-3 ::= string
node-4 ::= string
node-1-0 ::= "name" ws "=" ws node-2 node-1-1 | "city" ws "=" ws node-3 node-1-2 | "event" ws "=" ws node-4 node-1-4
node-1-1 ::= ws "," ws "city" ws "=" ws node-3 node-1-3 | ws "," ws "event" ws "=" ws node-4 node-1-5
node-1-2 ::= ws "," ws "name" ws "=" ws node-2 node-1-3 | ws "," ws "event" ws "=" ws node-4 node-1-6
node-1-3 ::= "" | ws "," ws "event" ws "=" ws node-4 node-1-7
node-1-4 ::= ws "," ws "name" ws "=" ws node-2 node-1-5 | ws "," ws "city" ws "=" ws node-3 node-1-6
node-1-5 ::= ws "," ws "city" ws "=" ws node-3 node-1-7
node-1-6 ::= ws "," ws "name" ws "=" ws node-2 node-1-7
node-1-7 ::= ""
node-6 ::= string
node-7 ::= string
node-8 ::= "'fastest'" | "'shortest'" | "'balanced'"
node-5-0 ::= "start" ws "=" ws node-6 node-5-1 | "destination" ws "=" ws node-7 node-5-2 | "method" ws "=" ws node-8 node-5-4
node-5-1 ::= ws "," ws "destination" ws "=" ws node-7 node-5-3 | ws "," ws "method" ws "=" ws node-8 node-5-5
node-5-2 ::= ws "," ws "start" ws "=" ws node-6 node-5-3 | ws "," ws "method" ws "=" ws node-8 node-5-6
node-5-3 ::= "" | ws "," ws "method" ws "=" ws node-8 node-5-7
node-5-4 ::= ws "," ws "start" ws "=" ws node-6 node-5-5 | ws "," ws "destination" ws "=" ws node-7 node-5-6
node-5-5 ::= ws "," ws "destination" ws "=" ws node-7 node-5-7
node-5-6 ::= ws "," ws "start" ws "=" ws node-6 node-5-7
node-5-7 ::= ""
call ::= ("chess_club_details.find" ws "(" ws node-1-0 ws ")") | ("route_planner.calculate_route" ws "(" ws node-5-0 ws ")")
