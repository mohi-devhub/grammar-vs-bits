root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= integer
node-2 ::= "[" ws (node-3 (ws "," ws node-3)*)? ws "]"
node-4 ::= boolean
node-1-0 ::= "data" ws "=" ws node-2 node-1-1 | "population" ws "=" ws node-4 node-1-2
node-1-1 ::= "" | ws "," ws "population" ws "=" ws node-4 node-1-3
node-1-2 ::= ws "," ws "data" ws "=" ws node-2 node-1-3
node-1-3 ::= ""
node-7 ::= integer
node-6 ::= "[" ws (node-7 (ws "," ws node-7)*)? ws "]"
node-5-0 ::= "data" ws "=" ws node-6 node-5-1
node-5-1 ::= ""
node-10 ::= integer
node-9 ::= "[" ws (node-10 (ws "," ws node-10)*)? ws "]"
node-8-0 ::= "data" ws "=" ws node-9 node-8-1
node-8-1 ::= ""
call ::= ("statistics.variance" ws "(" ws node-1-0 ws ")") | ("statistics.median" ws "(" ws node-5-0 ws ")") | ("statistics.mode" ws "(" ws node-8-0 ws ")")
