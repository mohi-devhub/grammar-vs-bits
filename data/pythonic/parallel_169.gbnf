root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= integer
node-3 ::= integer
node-4 ::= number
node-5 ::= integer
node-1-0 ::= "coupon_payment" ws "=" ws node-2 node-1-1 | "period" ws "=" ws node-3 node-1-2 | "discount_rate" ws "=" ws node-4 node-1-4 | "face_value" ws "=" ws node-5 node-1-8
node-1-1 ::= ws "," ws "period" ws "=" ws node-3 node-1-3 | ws "," ws "discount_rate" ws "=" ws node-4 node-1-5 | ws "," ws "face_value" ws "=" ws node-5 node-1-9
node-1-2 ::= ws "," ws "coupon_payment" ws "=" ws node-2 node-1-3 | ws "," ws "discount_rate" ws "=" ws node-4 node-1-6 | ws "," ws "face_value" ws "=" ws node-5 node-1-10
node-1-3 ::= ws "," ws "discount_rate" ws "=" ws node-4 node-1-7 | ws "," ws "face_value" ws "=" ws node-5 node-1-11
node-1-4 ::= ws "," ws "coupon_payment" ws "=" ws node-2 node-1-5 | ws "," ws "period" ws "=" ws node-3 node-1-6 | ws "," ws "face_value" ws "=" ws node-5 node-1-12
node-1-5 ::= ws "," ws "period" ws "=" ws node-3 node-1-7 | ws "," ws "face_value" ws "=" ws node-5 node-1-13
node-1-6 ::= ws "," ws "coupon_payment" ws "=" ws node-2 node-1-7 | ws "," ws "face_value" ws "=" ws node-5 node-1-14
node-1-7 ::= "" | ws "," ws "face_value" ws "=" ws node-5 node-1-15
node-1-8 ::= ws "," ws "coupon_payment" ws "=" ws node-2 node-1-9 | ws "," ws "period" ws "=" ws node-3 node-1-10 | ws "," ws "discount_rate" ws "=" ws node-4 node-1-12
node-1-9 ::= ws "," ws "period" ws "=" ws node-3 node-1-11 | ws "," ws "discount_rate" ws "=" ws node-4 node-1-13
node-1-10 ::= ws "," ws "coupon_payment" ws "=" ws node-2 node-1-11 | ws "," ws "discount_rate" ws "=" ws node-4 node-1-14
node-1-11 ::= ws "," ws "discount_rate" ws "=" ws node-4 node-1-15
node-1-12 ::= ws "," ws "coupon_payment" ws "=" ws node-2 node-1-13 | ws "," ws "period" ws "=" ws node-3 node-1-14
node-1-13 ::= ws "," ws "period" ws "=" ws node-3 node-1-15
node-1-14 ::= ws "," ws "coupon_payment" ws "=" ws node-2 node-1-15
node-1-15 ::= ""
call ::= ("calculate_discounted_cash_flow" ws "(" ws node-1-0 ws ")")
