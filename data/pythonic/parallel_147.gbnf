root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= number
node-3 ::= integer
node-1-0 ::= "distance_in_light_years" ws "=" ws node-2 node-1-1 | "speed_of_light" ws "=" ws node-3 node-1-2
node-1-1 ::= "" | ws "," ws "speed_of_light" ws "=" ws node-3 node-1-3
node-1-2 ::= ws "," ws "distance_in_light_years" ws "=" ws node-2 node-1-3
node-1-3 ::= ""
call ::= ("light_travel_time" ws "(" ws node-1-0 ws ")")
