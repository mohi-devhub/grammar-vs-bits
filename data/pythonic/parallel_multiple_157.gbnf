root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= integer
node-2 ::= "[" ws (node-3 (ws "," ws node-3)*)? ws "]"
node-5 ::= integer
node-4 ::= "[" ws (node-5 (ws "," ws node-5)*)? ws "]"
node-6 ::= number
node-1-0 ::= "dataset_A" ws "=" ws node-2 node-1-1 | "dataset_B" ws "=" ws node-4 node-1-2 | "alpha" ws "=" ws node-6 node-1-4
node-1-1 ::= ws "," ws "dataset_B" ws "=" ws node-4 node-1-3 | ws "," ws "alpha" ws "=" ws node-6 node-1-5
node-1-2 ::= ws "," ws "dataset_A" ws "=" ws node-2 node-1-3 | ws "," ws "alpha" ws "=" ws node-6 node-1-6
node-1-3 ::= "" | ws "," ws "alpha" ws "=" ws node-6 node-1-7
node-1-4 ::= ws "," ws "dataset_A" ws "=" ws node-2 node-1-5 | ws "," ws "dataset_B" ws "=" ws node-4 node-1-6
node-1-5 ::= ws "," ws "dataset_B" ws "=" ws node-4 node-1-7
node-1-6 ::= ws "," ws "dataset_A" ws "=" ws node-2 node-1-7
node-1-7 ::= ""
node-8 ::= integer
node-9 ::= integer
node-10 ::= string
node-7-0 ::= "base" ws "=" ws node-8 node-7-1 | "height" ws "=" ws node-9 node-7-2 | "unit" ws "=" ws node-10 node-7-4
node-7-1 ::= ws "," ws "height" ws "=" ws node-9 node-7-3 | ws "," ws "unit" ws "=" ws node-10 node-7-5
node-7-2 ::= ws "," ws "base" ws "=" ws node-8 node-7-3 | ws "," ws "unit" ws "=" ws node-10 node-7-6
node-7-3 ::= "" | ws "," ws "unit" ws "=" ws node-10 node-7-7
node-7-4 ::= ws "," ws "base" ws "=" ws node-8 node-7-5 | ws "," ws "height" ws "=" ws node-9 node-7-6
node-7-5 ::= ws "," ws "height" ws "=" ws node-9 node-7-7
node-7-6 ::= ws "," ws "base" ws "=" ws node-8 node-7-7
node-7-7 ::= ""
node-12 ::= string
node-13 ::= string
node-14 ::= integer
node-11-0 ::= "location" ws "=" ws node-12 node-11-1 | "genre" ws "=" ws node-13 node-11-2 | "days_ahead" ws "=" ws node-14 node-11-4
node-11-1 ::= ws "," ws "genre" ws "=" ws node-13 node-11-3 | ws "," ws "days_ahead" ws "=" ws node-14 node-11-5
node-11-2 ::= ws "," ws "location" ws "=" ws node-12 node-11-3 | ws "," ws "days_ahead" ws "=" ws node-14 node-11-6
node-11-3 ::= "" | ws "," ws "days_ahead" ws "=" ws node-14 node-11-7
node-11-4 ::= ws "," ws "location" ws "=" ws node-12 node-11-5 | ws "," ws "genre" ws "=" ws node-13 node-11-6
node-11-5 ::= ws "," ws "genre" ws "=" ws node-13 node-11-7
node-11-6 ::= ws "," ws "location" ws "=" ws node-12 node-11-7
node-11-7 ::= ""
call ::= ("t_test" ws "(" ws node-1-0 ws ")") | ("geometry.area_triangle" ws "(" ws node-7-0 ws ")") | ("event_finder.find_upcoming" ws "(" ws node-11-0 ws ")")
