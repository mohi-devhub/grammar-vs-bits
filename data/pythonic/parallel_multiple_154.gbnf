node-5-3 ::= "" | ws "," ws "round_to" ws "=" ws node-8 node-5-7
node-5-4 ::= ws "," ws "total_outcomes" ws "=" ws node-6 node-5-5 | ws "," ws "favorable_outcomes" ws "=" ws node-7 node-5-6
node-5-5 ::= ws "," ws "favorable_outcomes" ws "=" ws node-7 node-5-7
node-5-6 ::= ws "," ws "total_outcomes" ws "=" ws node-6 node-5-7
