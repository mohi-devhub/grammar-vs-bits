root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= string
node-2 ::= "[" ws (node-3 (ws "," ws node-3)*)? ws "]"
node-1-0 ::= "moves" ws "=" ws node-2 node-1-1
node-1-1 ::= ""
node-5 ::= integer
node-7 ::= integer
node-6 ::= "[" ws (node-7 (ws "," ws node-7)*)? ws "]"
node-4-0 ::= "rounds" ws "=" ws node-5 node-4-1 | "start_board" ws "=" ws node-6 node-4-2
node-4-1 ::= ws "," ws "start_board" ws "=" ws node-6 node-4-3
node-4-2 ::= ws "," ws "rounds" ws "=" ws node-5 node-4-3
node-4-3 ::= ""
call ::= ("chess.play" ws "(" ws node-1-0 ws ")") | ("game_of_life.play" ws "(" ws node-4-0 ws ")")
