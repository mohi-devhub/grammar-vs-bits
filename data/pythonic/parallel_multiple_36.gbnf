root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= string
node-4 ::= "'signatories'" | "'ratification date'" | "'clauses'" | "'overview'"
node-3 ::= "[" ws (node-4 (ws "," ws node-4)*)? ws "]"
node-1-0 ::= "treaty_name" ws "=" ws node-2 node-1-1 | "info_requested" ws "=" ws node-3 node-1-2
node-1-1 ::= ws "," ws "info_requested" ws "=" ws node-3 node-1-3
node-1-2 ::= ws "," ws "treaty_name" ws "=" ws node-2 node-1-3
node-1-3 ::= ""
node-6 ::= string
node-8 ::= "'overview'" | "'causalities'" | "'date'"
node-7 ::= "[" ws (node-8 (ws "," ws node-8)*)? ws "]"
node-5-0 ::= "battle_name" ws "=" ws node-6 node-5-1 | "specific_info" ws "=" ws node-7 node-5-2
node-5-1 ::= ws "," ws "specific_info" ws "=" ws node-7 node-5-3
node-5-2 ::= ws "," ws "battle_name" ws "=" ws node-6 node-5-3
node-5-3 ::= ""
call ::= ("euro_history.treaty_info" ws "(" ws node-1-0 ws ")") | ("euro_history.battle_details" ws "(" ws node-5-0 ws ")")
