root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= integer
node-3 ::= number
node-4 ::= integer
node-5 ::= integer
node-1-0 ::= "principle" ws "=" ws node-2 node-1-1 | "rate" ws "=" ws node-3 node-1-2 | "time" ws "=" ws node-4 node-1-4 | "n" ws "=" ws node-5 node-1-8
node-1-1 ::= ws "," ws "rate" ws "=" ws node-3 node-1-3 | ws "," ws "time" ws "=" ws node-4 node-1-5 | ws "," ws "n" ws "=" ws node-5 node-1-9
node-1-2 ::= ws "," ws "principle" ws "=" ws node-2 node-1-3 | ws "," ws "time" ws "=" ws node-4 node-1-6 | ws "," ws "n" ws "=" ws node-5 node-1-10
node-1-3 ::= ws "," ws "time" ws "=" ws node-4 node-1-7 | ws "," ws "n" ws "=" ws node-5 node-1-11
node-1-4 ::= ws "," ws "principle" ws "=" ws node-2 node-1-5 | ws "," ws "rate" ws "=" ws node-3 node-1-6 | ws "," ws "n" ws "=" ws node-5 node-1-12
node-1-5 ::= ws "," ws "rate" ws "=" ws node-3 node-1-7 | ws "," ws "n" ws "=" ws node-5 node-1-13
node-1-6 ::= ws "," ws "principle" ws "=" ws node-2 node-1-7 | ws "," ws "n" ws "=" ws node-5 node-1-14
node-1-7 ::= ws "," ws "n" ws "=" ws node-5 node-1-15
node-1-8 ::= ws "," ws "principle" ws "=" ws node-2 node-1-9 | ws "," ws "rate" ws "=" ws node-3 node-1-10 | ws "," ws "time" ws "=" ws node-4 node-1-12
node-1-9 ::= ws "," ws "rate" ws "=" ws node-3 node-1-11 | ws "," ws "time" ws "=" ws node-4 node-1-13
node-1-10 ::= ws "," ws "principle" ws "=" ws node-2 node-1-11 | ws "," ws "time" ws "=" ws node-4 node-1-14
node-1-11 ::= ws "," ws "time" ws "=" ws node-4 node-1-15
node-1-12 ::= ws "," ws "principle" ws "=" ws node-2 node-1-13 | ws "," ws "rate" ws "=" ws node-3 node-1-14
node-1-13 ::= ws "," ws "rate" ws "=" ws node-3 node-1-15
node-1-14 ::= ws "," ws "principle" ws "=" ws node-2 node-1-15
node-1-15 ::= ""
node-7 ::= integer
node-8 ::= number
node-9 ::= integer
node-6-0 ::= "principle" ws "=" ws node-7 node-6-1 | "rate" ws "=" ws node-8 node-6-2 | "time" ws "=" ws node-9 node-6-4
node-6-1 ::= ws "," ws "rate" ws "=" ws node-8 node-6-3 | ws "," ws "time" ws "=" ws node-9 node-6-5
node-6-2 ::= ws "," ws "principle" ws "=" ws node-7 node-6-3 | ws "," ws "time" ws "=" ws node-9 node-6-6
node-6-3 ::= ws "," ws "time" ws "=" ws node-9 node-6-7
node-6-4 ::= ws "," ws "principle" ws "=" ws node-7 node-6-5 | ws "," ws "rate" ws "=" ws node-8 node-6-6
node-6-5 ::= ws "," ws "rate" ws "=" ws node-8 node-6-7
node-6-6 ::= ws "," ws "principle" ws "=" ws node-7 node-6-7
node-6-7 ::= ""
call ::= ("financial.compound_interest" ws "(" ws node-1-0 ws ")") | ("financial.simple_interest" ws "(" ws node-6-0 ws ")")
