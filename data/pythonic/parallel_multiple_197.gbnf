root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= string
node-4 ::= string
node-3 ::= "[" ws (node-4 (ws "," ws node-4)*)? ws "]"
node-5 ::= integer
node-1-0 ::= "dietary_restriction" ws "=" ws node-2 node-1-1 | "ingredients" ws "=" ws node-3 node-1-2 | "servings" ws "=" ws node-5 node-1-4
node-1-1 ::= ws "," ws "ingredients" ws "=" ws node-3 node-1-3 | ws "," ws "servings" ws "=" ws node-5 node-1-5
node-1-2 ::= ws "," ws "dietary_restriction" ws "=" ws node-2 node-1-3 | ws "," ws "servings" ws "=" ws node-5 node-1-6
node-1-3 ::= ws "," ws "servings" ws "=" ws node-5 node-1-7
node-1-4 ::= ws "," ws "dietary_restriction" ws "=" ws node-2 node-1-5 | ws "," ws "ingredients" ws "=" ws node-3 node-1-6
node-1-5 ::= ws "," ws "ingredients" ws "=" ws node-3 node-1-7
node-1-6 ::= ws "," ws "dietary_restriction" ws "=" ws node-2 node-1-7
node-1-7 ::= ""
node-7 ::= string
node-8 ::= string
node-6-0 ::= "place1" ws "=" ws node-7 node-6-1 | "place2" ws "=" ws node-8 node-6-2
node-6-1 ::= ws "," ws "place2" ws "=" ws node-8 node-6-3
node-6-2 ::= ws "," ws "place1" ws "=" ws node-7 node-6-3
node-6-3 ::= ""
node-10 ::= string
node-11 ::= integer
node-12 ::= boolean
node-9-0 ::= "location" ws "=" ws node-10 node-9-1 | "duration" ws "=" ws node-11 node-9-2 | "include_precipitation" ws "=" ws node-12 node-9-4
node-9-1 ::= ws "," ws "duration" ws "=" ws node-11 node-9-3 | ws "," ws "include_precipitation" ws "=" ws node-12 node-9-5
node-9-2 ::= ws "," ws "location" ws "=" ws node-10 node-9-3 | ws "," ws "include_precipitation" ws "=" ws node-12 node-9-6
node-9-3 ::= "" | ws "," ws "include_precipitation" ws "=" ws node-12 node-9-7
node-9-4 ::= ws "," ws "location" ws "=" ws node-10 node-9-5 | ws "," ws "duration" ws "=" ws node-11 node-9-6
node-9-5 ::= ws "," ws "duration" ws "=" ws node-11 node-9-7
node-9-6 ::= ws "," ws "location" ws "=" ws node-10 node-9-7
node-9-7 ::= ""
call ::= ("recipe_search" ws "(" ws node-1-0 ws ")") | ("get_time_difference" ws "(" ws node-6-0 ws ")") | ("detailed_weather_forecast" ws "(" ws node-9-0 ws ")")
