root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= string
node-1-0 ::= "country" ws "=" ws node-2 node-1-1
node-1-1 ::= ""
node-4 ::= string
node-3-0 ::= "country" ws "=" ws node-4 node-3-1
node-3-1 ::= ""
node-6 ::= string
node-5-0 ::= "country" ws "=" ws node-6 node-5-1
node-5-1 ::= ""
call ::= ("country_info.largest_city" ws "(" ws node-1-0 ws ")") | ("country_info.population" ws "(" ws node-3-0 ws ")") | ("country_info.capital" ws "(" ws node-5-0 ws ")")
