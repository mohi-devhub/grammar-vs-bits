root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= number
node-3 ::= number
node-4 ::= number
node-1-0 ::= "initial_velocity" ws "=" ws node-2 node-1-1 | "time" ws "=" ws node-3 node-1-2 | "acceleration" ws "=" ws node-4 node-1-4
node-1-1 ::= ws "," ws "time" ws "=" ws node-3 node-1-3 | ws "," ws "acceleration" ws "=" ws node-4 node-1-5
node-1-2 ::= ws "," ws "initial_velocity" ws "=" ws node-2 node-1-3 | ws "," ws "acceleration" ws "=" ws node-4 node-1-6
node-1-3 ::= "" | ws "," ws "acceleration" ws "=" ws node-4 node-1-7
node-1-4 ::= ws "," ws "initial_velocity" ws "=" ws node-2 node-1-5 | ws "," ws "time" ws "=" ws node-3 node-1-6
node-1-5 ::= ws "," ws "time" ws "=" ws node-3 node-1-7
node-1-6 ::= ws "," ws "initial_velocity" ws "=" ws node-2 node-1-7
node-1-7 ::= ""
node-6 ::= number
node-7 ::= number
node-8 ::= number
node-5-0 ::= "initial_velocity" ws "=" ws node-6 node-5-1 | "time" ws "=" ws node-7 node-5-2 | "acceleration" ws "=" ws node-8 node-5-4
node-5-1 ::= ws "," ws "time" ws "=" ws node-7 node-5-3 | ws "," ws "acceleration" ws "=" ws node-8 node-5-5
node-5-2 ::= ws "," ws "initial_velocity" ws "=" ws node-6 node-5-3 | ws "," ws "acceleration" ws "=" ws node-8 node-5-6
node-5-3 ::= "" | ws "," ws "acceleration" ws "=" ws node-8 node-5-7
node-5-4 ::= ws "," ws "initial_velocity" ws "=" ws node-6 node-5-5 | ws "," ws "time" ws "=" ws node-7 node-5-6
node-5-5 ::= ws "," ws "time" ws "=" ws node-7 node-5-7
node-5-6 ::= ws "," ws "initial_velocity" ws "=" ws node-6 node-5-7
node-5-7 ::= ""
node-10 ::= number
node-11 ::= number
node-9-0 ::= "frequency" ws "=" ws node-10 node-9-1 | "wavelength" ws "=" ws node-11 node-9-2
node-9-1 ::= ws "," ws "wavelength" ws "=" ws node-11 node-9-3
node-9-2 ::= ws "," ws "frequency" ws "=" ws node-10 node-9-3
node-9-3 ::= ""
call ::= ("kinematics.distance" ws "(" ws node-1-0 ws ")") | ("kinematics.final_velocity" ws "(" ws node-5-0 ws ")") | ("physics.wave_velocity" ws "(" ws node-9-0 ws ")")
