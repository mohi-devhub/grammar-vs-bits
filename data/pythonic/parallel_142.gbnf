root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= integer
node-4 ::= string
node-5 ::= string
node-3-s-0 ::= "" | ("\"name\"" | "'name'") ws ":" ws node-4 node-3-s-1 | ("\"email\"" | "'email'") ws ":" ws node-5 node-3-s-2
node-3-s-1 ::= "" | ws "," ws ("\"email\"" | "'email'") ws ":" ws node-5 node-3-s-3
node-3-s-2 ::= "" | ws "," ws ("\"name\"" | "'name'") ws ":" ws node-4 node-3-s-3
node-3-s-3 ::= ""
node-3 ::= "{" ws node-3-s-0 ws "}"
node-6 ::= string
node-1-0 ::= "user_id" ws "=" ws node-2 node-1-1 | "update_info" ws "=" ws node-3 node-1-2 | "database" ws "=" ws node-6 node-1-4
node-1-1 ::= ws "," ws "update_info" ws "=" ws node-3 node-1-3 | ws "," ws "database" ws "=" ws node-6 node-1-5
node-1-2 ::= ws "," ws "user_id" ws "=" ws node-2 node-1-3 | ws "," ws "database" ws "=" ws node-6 node-1-6
node-1-3 ::= "" | ws "," ws "database" ws "=" ws node-6 node-1-7
node-1-4 ::= ws "," ws "user_id" ws "=" ws node-2 node-1-5 | ws "," ws "update_info" ws "=" ws node-3 node-1-6
node-1-5 ::= ws "," ws "update_info" ws "=" ws node-3 node-1-7
node-1-6 ::= ws "," ws "user_id" ws "=" ws node-2 node-1-7
node-1-7 ::= ""
call ::= ("update_user_info" ws "(" ws node-1-0 ws ")")
