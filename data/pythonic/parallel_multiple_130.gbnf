root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= integer
node-3 ::= integer
node-4 ::= integer
node-1-0 ::= "a" ws "=" ws node-2 node-1-1 | "b" ws "=" ws node-3 node-1-2 | "c" ws "=" ws node-4 node-1-4
node-1-1 ::= ws "," ws "b" ws "=" ws node-3 node-1-3 | ws "," ws "c" ws "=" ws node-4 node-1-5
node-1-2 ::= ws "," ws "a" ws "=" ws node-2 node-1-3 | ws "," ws "c" ws "=" ws node-4 node-1-6
node-1-3 ::= ws "," ws "c" ws "=" ws node-4 node-1-7
node-1-4 ::= ws "," ws "a" ws "=" ws node-2 node-1-5 | ws "," ws "b" ws "=" ws node-3 node-1-6
node-1-5 ::= ws "," ws "b" ws "=" ws node-3 node-1-7
node-1-6 ::= ws "," ws "a" ws "=" ws node-2 node-1-7
node-1-7 ::= ""
node-6 ::= string
node-7 ::= integer
node-8 ::= number
node-9 ::= integer
node-5-0 ::= "stock" ws "=" ws node-6 node-5-1 | "invested_amount" ws "=" ws node-7 node-5-2 | "expected_annual_return" ws "=" ws node-8 node-5-4 | "years" ws "=" ws node-9 node-5-8
node-5-1 ::= ws "," ws "invested_amount" ws "=" ws node-7 node-5-3 | ws "," ws "expected_annual_return" ws "=" ws node-8 node-5-5 | ws "," ws "years" ws "=" ws node-9 node-5-9
node-5-2 ::= ws "," ws "stock" ws "=" ws node-6 node-5-3 | ws "," ws "expected_annual_return" ws "=" ws node-8 node-5-6 | ws "," ws "years" ws "=" ws node-9 node-5-10
node-5-3 ::= ws "," ws "expected_annual_return" ws "=" ws node-8 node-5-7 | ws "," ws "years" ws "=" ws node-9 node-5-11
node-5-4 ::= ws "," ws "stock" ws "=" ws node-6 node-5-5 | ws "," ws "invested_amount" ws "=" ws node-7 node-5-6 | ws "," ws "years" ws "=" ws node-9 node-5-12
node-5-5 ::= ws "," ws "invested_amount" ws "=" ws node-7 node-5-7 | ws "," ws "years" ws "=" ws node-9 node-5-13
node-5-6 ::= ws "," ws "stock" ws "=" ws node-6 node-5-7 | ws "," ws "years" ws "=" ws node-9 node-5-14
node-5-7 ::= ws "," ws "years" ws "=" ws node-9 node-5-15
node-5-8 ::= ws "," ws "stock" ws "=" ws node-6 node-5-9 | ws "," ws "invested_amount" ws "=" ws node-7 node-5-10 | ws "," ws "expected_annual_return" ws "=" ws node-8 node-5-12
node-5-9 ::= ws "," ws "invested_amount" ws "=" ws node-7 node-5-11 | ws "," ws "expected_annual_return" ws "=" ws node-8 node-5-13
node-5-10 ::= ws "," ws "stock" ws "=" ws node-6 node-5-11 | ws "," ws "expected_annual_return" ws "=" ws node-8 node-5-14
node-5-11 ::= ws "," ws "expected_annual_return" ws "=" ws node-8 node-5-15
node-5-12 ::= ws "," ws "stock" ws "=" ws node-6 node-5-13 | ws "," ws "invested_amount" ws "=" ws node-7 node-5-14
node-5-13 ::= ws "," ws "invested_amount" ws "=" ws node-7 node-5-15
node-5-14 ::= ws "," ws "stock" ws "=" ws node-6 node-5-15
node-5-15 ::= ""
node-11 ::= string
node-12 ::= string
node-13 ::= string
node-10-0 ::= "company_name" ws "=" ws node-11 node-10-1 | "detail_level" ws "=" ws node-12 node-10-2 | "market" ws "=" ws node-13 node-10-4
node-10-1 ::= ws "," ws "detail_level" ws "=" ws node-12 node-10-3 | ws "," ws "market" ws "=" ws node-13 node-10-5
node-10-2 ::= ws "," ws "company_name" ws "=" ws node-11 node-10-3 | ws "," ws "market" ws "=" ws node-13 node-10-6
node-10-3 ::= "" | ws "," ws "market" ws "=" ws node-13 node-10-7
node-10-4 ::= ws "," ws "company_name" ws "=" ws node-11 node-10-5 | ws "," ws "detail_level" ws "=" ws node-12 node-10-6
node-10-5 ::= ws "," ws "detail_level" ws "=" ws node-12 node-10-7
node-10-6 ::= ws "," ws "company_name" ws "=" ws node-11 node-10-7
node-10-7 ::= ""
call ::= ("solve_quadratic_equation" ws "(" ws node-1-0 ws ")") | ("portfolio_future_value" ws "(" ws node-5-0 ws ")") | ("get_stock_info" ws "(" ws node-10-0 ws ")")
