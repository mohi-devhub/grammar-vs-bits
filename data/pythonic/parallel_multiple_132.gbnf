root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= string
node-3 ::= integer
node-4 ::= string
node-1-0 ::= "function" ws "=" ws node-2 node-1-1 | "value" ws "=" ws node-3 node-1-2 | "function_variable" ws "=" ws node-4 node-1-4
node-1-1 ::= ws "," ws "value" ws "=" ws node-3 node-1-3 | ws "," ws "function_variable" ws "=" ws node-4 node-1-5
node-1-2 ::= ws "," ws "function" ws "=" ws node-2 node-1-3 | ws "," ws "function_variable" ws "=" ws node-4 node-1-6
node-1-3 ::= "" | ws "," ws "function_variable" ws "=" ws node-4 node-1-7
node-1-4 ::= ws "," ws "function" ws "=" ws node-2 node-1-5 | ws "," ws "value" ws "=" ws node-3 node-1-6
node-1-5 ::= ws "," ws "value" ws "=" ws node-3 node-1-7
node-1-6 ::= ws "," ws "function" ws "=" ws node-2 node-1-7
node-1-7 ::= ""
node-6 ::= string
node-8 ::= "'strengths'" | "'weaknesses'"
node-7 ::= "[" ws (node-8 (ws "," ws node-8)*)? ws "]"
node-5-0 ::= "type" ws "=" ws node-6 node-5-1 | "traits" ws "=" ws node-7 node-5-2
node-5-1 ::= "" | ws "," ws "traits" ws "=" ws node-7 node-5-3
node-5-2 ::= ws "," ws "type" ws "=" ws node-6 node-5-3
node-5-3 ::= ""
call ::= ("calculus.derivative" ws "(" ws node-1-0 ws ")") | ("get_personality_traits" ws "(" ws node-5-0 ws ")")
