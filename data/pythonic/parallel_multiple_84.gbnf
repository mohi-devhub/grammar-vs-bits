root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= number
node-3 ::= number
node-1-0 ::= "num" ws "=" ws node-2 node-1-1 | "accuracy" ws "=" ws node-3 node-1-2
node-1-1 ::= "" | ws "," ws "accuracy" ws "=" ws node-3 node-1-3
node-1-2 ::= ws "," ws "num" ws "=" ws node-2 node-1-3
node-1-3 ::= ""
node-5 ::= integer
node-6 ::= integer
node-4-0 ::= "num1" ws "=" ws node-5 node-4-1 | "num2" ws "=" ws node-6 node-4-2
node-4-1 ::= ws "," ws "num2" ws "=" ws node-6 node-4-3
node-4-2 ::= ws "," ws "num1" ws "=" ws node-5 node-4-3
node-4-3 ::= ""
node-8 ::= integer
node-9 ::= integer
node-7-0 ::= "num1" ws "=" ws node-8 node-7-1 | "num2" ws "=" ws node-9 node-7-2
node-7-1 ::= ws "," ws "num2" ws "=" ws node-9 node-7-3
node-7-2 ::= ws "," ws "num1" ws "=" ws node-8 node-7-3
node-7-3 ::= ""
call ::= ("math.sqrt" ws "(" ws node-1-0 ws ")") | ("math.gcd" ws "(" ws node-4-0 ws ")") | ("math.lcm" ws "(" ws node-7-0 ws ")")
