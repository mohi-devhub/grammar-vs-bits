root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= string
node-3 ::= string
node-4 ::= number
node-1-0 ::= "from_account" ws "=" ws node-2 node-1-1 | "to_account" ws "=" ws node-3 node-1-2 | "amount" ws "=" ws node-4 node-1-4
node-1-1 ::= ws "," ws "to_account" ws "=" ws node-3 node-1-3 | ws "," ws "amount" ws "=" ws node-4 node-1-5
node-1-2 ::= ws "," ws "from_account" ws "=" ws node-2 node-1-3 | ws "," ws "amount" ws "=" ws node-4 node-1-6
node-1-3 ::= ws "," ws "amount" ws "=" ws node-4 node-1-7
node-1-4 ::= ws "," ws "from_account" ws "=" ws node-2 node-1-5 | ws "," ws "to_account" ws "=" ws node-3 node-1-6
node-1-5 ::= ws "," ws "to_account" ws "=" ws node-3 node-1-7
node-1-6 ::= ws "," ws "from_account" ws "=" ws node-2 node-1-7
node-1-7 ::= ""
node-6 ::= number
node-7 ::= number
node-8 ::= integer
node-5-0 ::= "principal" ws "=" ws node-6 node-5-1 | "rate" ws "=" ws node-7 node-5-2 | "time" ws "=" ws node-8 node-5-4
node-5-1 ::= ws "," ws "rate" ws "=" ws node-7 node-5-3 | ws "," ws "time" ws "=" ws node-8 node-5-5
node-5-2 ::= ws "," ws "principal" ws "=" ws node-6 node-5-3 | ws "," ws "time" ws "=" ws node-8 node-5-6
node-5-3 ::= ws "," ws "time" ws "=" ws node-8 node-5-7
node-5-4 ::= ws "," ws "principal" ws "=" ws node-6 node-5-5 | ws "," ws "rate" ws "=" ws node-7 node-5-6
node-5-5 ::= ws "," ws "rate" ws "=" ws node-7 node-5-7
node-5-6 ::= ws "," ws "principal" ws "=" ws node-6 node-5-7
node-5-7 ::= ""
call ::= ("bank_account.transfer" ws "(" ws node-1-0 ws ")") | ("bank_account.calculate_interest" ws "(" ws node-5-0 ws ")")
