root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= string
node-3 ::= string
node-1-0 ::= "genre" ws "=" ws node-2 node-1-1 | "title" ws "=" ws node-3 node-1-2
node-1-1 ::= "" | ws "," ws "title" ws "=" ws node-3 node-1-3
node-1-2 ::= ws "," ws "genre" ws "=" ws node-2 node-1-3
node-1-3 ::= ""
node-5 ::= string
node-6 ::= string
node-7 ::= string
node-4-0 ::= "location" ws "=" ws node-5 node-4-1 | "genre" ws "=" ws node-6 node-4-2 | "title" ws "=" ws node-7 node-4-4
node-4-1 ::= ws "," ws "genre" ws "=" ws node-6 node-4-3 | ws "," ws "title" ws "=" ws node-7 node-4-5
node-4-2 ::= ws "," ws "location" ws "=" ws node-5 node-4-3 | ws "," ws "title" ws "=" ws node-7 node-4-6
node-4-3 ::= "" | ws "," ws "title" ws "=" ws node-7 node-4-7
node-4-4 ::= ws "," ws "location" ws "=" ws node-5 node-4-5 | ws "," ws "genre" ws "=" ws node-6 node-4-6
node-4-5 ::= ws "," ws "genre" ws "=" ws node-6 node-4-7
node-4-6 ::= ws "," ws "location" ws "=" ws node-5 node-4-7
node-4-7 ::= ""
node-9 ::= string
node-10 ::= string
node-8-0 ::= "genre" ws "=" ws node-9 node-8-1 | "title" ws "=" ws node-10 node-8-2
node-8-1 ::= "" | ws "," ws "title" ws "=" ws node-10 node-8-3
node-8-2 ::= ws "," ws "genre" ws "=" ws node-9 node-8-3
node-8-3 ::= ""
call ::= ("google.books_search" ws "(" ws node-1-0 ws ")") | ("library.search_books" ws "(" ws node-4-0 ws ")") | ("openlibrary.books_search" ws "(" ws node-8-0 ws ")")
