root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= string
node-3 ::= string
node-4 ::= string
node-1-0 ::= "from_city" ws "=" ws node-2 node-1-1 | "to_city" ws "=" ws node-3 node-1-2 | "date" ws "=" ws node-4 node-1-4
node-1-1 ::= ws "," ws "to_city" ws "=" ws node-3 node-1-3 | ws "," ws "date" ws "=" ws node-4 node-1-5
node-1-2 ::= ws "," ws "from_city" ws "=" ws node-2 node-1-3 | ws "," ws "date" ws "=" ws node-4 node-1-6
node-1-3 ::= "" | ws "," ws "date" ws "=" ws node-4 node-1-7
node-1-4 ::= ws "," ws "from_city" ws "=" ws node-2 node-1-5 | ws "," ws "to_city" ws "=" ws node-3 node-1-6
node-1-5 ::= ws "," ws "to_city" ws "=" ws node-3 node-1-7
node-1-6 ::= ws "," ws "from_city" ws "=" ws node-2 node-1-7
node-1-7 ::= ""
node-6 ::= string
node-7 ::= string
node-5-0 ::= "city1" ws "=" ws node-6 node-5-1 | "city2" ws "=" ws node-7 node-5-2
node-5-1 ::= ws "," ws "city2" ws "=" ws node-7 node-5-3
node-5-2 ::= ws "," ws "city1" ws "=" ws node-6 node-5-3
node-5-3 ::= ""
node-9 ::= string
node-10 ::= string
node-11 ::= string
node-8-0 ::= "origin" ws "=" ws node-9 node-8-1 | "destination" ws "=" ws node-10 node-8-2 | "unit" ws "=" ws node-11 node-8-4
node-8-1 ::= ws "," ws "destination" ws "=" ws node-10 node-8-3 | ws "," ws "unit" ws "=" ws node-11 node-8-5
node-8-2 ::= ws "," ws "origin" ws "=" ws node-9 node-8-3 | ws "," ws "unit" ws "=" ws node-11 node-8-6
node-8-3 ::= "" | ws "," ws "unit" ws "=" ws node-11 node-8-7
node-8-4 ::= ws "," ws "origin" ws "=" ws node-9 node-8-5 | ws "," ws "destination" ws "=" ws node-10 node-8-6
node-8-5 ::= ws "," ws "destination" ws "=" ws node-10 node-8-7
node-8-6 ::= ws "," ws "origin" ws "=" ws node-9 node-8-7
node-8-7 ::= ""
call ::= ("flights.search" ws "(" ws node-1-0 ws ")") | ("timezones.get_difference" ws "(" ws node-5-0 ws ")") | ("geodistance.find" ws "(" ws node-8-0 ws ")")
