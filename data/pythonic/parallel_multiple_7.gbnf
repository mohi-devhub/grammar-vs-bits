root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= integer
node-3 ::= integer
node-1-0 ::= "mass" ws "=" ws node-2 node-1-1 | "acceleration" ws "=" ws node-3 node-1-2
node-1-1 ::= ws "," ws "acceleration" ws "=" ws node-3 node-1-3
node-1-2 ::= ws "," ws "mass" ws "=" ws node-2 node-1-3
node-1-3 ::= ""
node-5 ::= integer
node-6 ::= integer
node-4-0 ::= "velocity" ws "=" ws node-5 node-4-1 | "distance" ws "=" ws node-6 node-4-2
node-4-1 ::= ws "," ws "distance" ws "=" ws node-6 node-4-3
node-4-2 ::= ws "," ws "velocity" ws "=" ws node-5 node-4-3
node-4-3 ::= ""
call ::= ("physics.calculate_force" ws "(" ws node-1-0 ws ")") | ("kinematics.calculate_time" ws "(" ws node-4-0 ws ")")
