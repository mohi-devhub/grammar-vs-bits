root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= integer
node-3 ::= string
node-4 ::= string
node-1-0 ::= "value" ws "=" ws node-2 node-1-1 | "from_unit" ws "=" ws node-3 node-1-2 | "to_unit" ws "=" ws node-4 node-1-4
node-1-1 ::= ws "," ws "from_unit" ws "=" ws node-3 node-1-3 | ws "," ws "to_unit" ws "=" ws node-4 node-1-5
node-1-2 ::= ws "," ws "value" ws "=" ws node-2 node-1-3 | ws "," ws "to_unit" ws "=" ws node-4 node-1-6
node-1-3 ::= ws "," ws "to_unit" ws "=" ws node-4 node-1-7
node-1-4 ::= ws "," ws "value" ws "=" ws node-2 node-1-5 | ws "," ws "from_unit" ws "=" ws node-3 node-1-6
node-1-5 ::= ws "," ws "from_unit" ws "=" ws node-3 node-1-7
node-1-6 ::= ws "," ws "value" ws "=" ws node-2 node-1-7
node-1-7 ::= ""
node-6 ::= integer
node-7 ::= string
node-8 ::= string
node-9 ::= boolean
node-5-0 ::= "amount" ws "=" ws node-6 node-5-1 | "from_currency" ws "=" ws node-7 node-5-2 | "to_currency" ws "=" ws node-8 node-5-4 | "live_conversion" ws "=" ws node-9 node-5-8
node-5-1 ::= ws "," ws "from_currency" ws "=" ws node-7 node-5-3 | ws "," ws "to_currency" ws "=" ws node-8 node-5-5 | ws "," ws "live_conversion" ws "=" ws node-9 node-5-9
node-5-2 ::= ws "," ws "amount" ws "=" ws node-6 node-5-3 | ws "," ws "to_currency" ws "=" ws node-8 node-5-6 | ws "," ws "live_conversion" ws "=" ws node-9 node-5-10
node-5-3 ::= ws "," ws "to_currency" ws "=" ws node-8 node-5-7 | ws "," ws "live_conversion" ws "=" ws node-9 node-5-11
node-5-4 ::= ws "," ws "amount" ws "=" ws node-6 node-5-5 | ws "," ws "from_currency" ws "=" ws node-7 node-5-6 | ws "," ws "live_conversion" ws "=" ws node-9 node-5-12
node-5-5 ::= ws "," ws "from_currency" ws "=" ws node-7 node-5-7 | ws "," ws "live_conversion" ws "=" ws node-9 node-5-13
node-5-6 ::= ws "," ws "amount" ws "=" ws node-6 node-5-7 | ws "," ws "live_conversion" ws "=" ws node-9 node-5-14
node-5-7 ::= "" | ws "," ws "live_conversion" ws "=" ws node-9 node-5-15
node-5-8 ::= ws "," ws "amount" ws "=" ws node-6 node-5-9 | ws "," ws "from_currency" ws "=" ws node-7 node-5-10 | ws "," ws "to_currency" ws "=" ws node-8 node-5-12
node-5-9 ::= ws "," ws "from_currency" ws "=" ws node-7 node-5-11 | ws "," ws "to_currency" ws "=" ws node-8 node-5-13
node-5-10 ::= ws "," ws "amount" ws "=" ws node-6 node-5-11 | ws "," ws "to_currency" ws "=" ws node-8 node-5-14
node-5-11 ::= ws "," ws "to_currency" ws "=" ws node-8 node-5-15
node-5-12 ::= ws "," ws "amount" ws "=" ws node-6 node-5-13 | ws "," ws "from_currency" ws "=" ws node-7 node-5-14
node-5-13 ::= ws "," ws "from_currency" ws "=" ws node-7 node-5-15
node-5-14 ::= ws "," ws "amount" ws "=" ws node-6 node-5-15
node-5-15 ::= ""
call ::= ("unit_conversion.convert" ws "(" ws node-1-0 ws ")") | ("currency_exchange.convert" ws "(" ws node-5-0 ws ")")
