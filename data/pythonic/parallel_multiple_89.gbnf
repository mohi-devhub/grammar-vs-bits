root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= string
node-4 ::= string
node-3 ::= "[" ws (node-4 (ws "," ws node-4)*)? ws "]"
node-5 ::= number
node-1-0 ::= "location" ws "=" ws node-2 node-1-1 | "items" ws "=" ws node-3 node-1-2 | "max_delivery_cost" ws "=" ws node-5 node-1-4
node-1-1 ::= ws "," ws "items" ws "=" ws node-3 node-1-3 | ws "," ws "max_delivery_cost" ws "=" ws node-5 node-1-5
node-1-2 ::= ws "," ws "location" ws "=" ws node-2 node-1-3 | ws "," ws "max_delivery_cost" ws "=" ws node-5 node-1-6
node-1-3 ::= "" | ws "," ws "max_delivery_cost" ws "=" ws node-5 node-1-7
node-1-4 ::= ws "," ws "location" ws "=" ws node-2 node-1-5 | ws "," ws "items" ws "=" ws node-3 node-1-6
node-1-5 ::= ws "," ws "items" ws "=" ws node-3 node-1-7
node-1-6 ::= ws "," ws "location" ws "=" ws node-2 node-1-7
node-1-7 ::= ""
node-7 ::= string
node-8 ::= string
node-9 ::= number
node-6-0 ::= "source" ws "=" ws node-7 node-6-1 | "destination" ws "=" ws node-8 node-6-2 | "max_cost" ws "=" ws node-9 node-6-4
node-6-1 ::= ws "," ws "destination" ws "=" ws node-8 node-6-3 | ws "," ws "max_cost" ws "=" ws node-9 node-6-5
node-6-2 ::= ws "," ws "source" ws "=" ws node-7 node-6-3 | ws "," ws "max_cost" ws "=" ws node-9 node-6-6
node-6-3 ::= "" | ws "," ws "max_cost" ws "=" ws node-9 node-6-7
node-6-4 ::= ws "," ws "source" ws "=" ws node-7 node-6-5 | ws "," ws "destination" ws "=" ws node-8 node-6-6
node-6-5 ::= ws "," ws "destination" ws "=" ws node-8 node-6-7
node-6-6 ::= ws "," ws "source" ws "=" ws node-7 node-6-7
node-6-7 ::= ""
call ::= ("grocery_delivery.order" ws "(" ws node-1-0 ws ")") | ("ride_hailing.get_rides" ws "(" ws node-6-0 ws ")")
