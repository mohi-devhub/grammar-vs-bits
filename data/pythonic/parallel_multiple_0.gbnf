root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= integer
node-3 ::= integer
node-5 ::= integer
node-4 ::= "[" ws (node-5 (ws "," ws node-5)*)? ws "]"
node-1-0 ::= "lower_limit" ws "=" ws node-2 node-1-1 | "upper_limit" ws "=" ws node-3 node-1-2 | "multiples" ws "=" ws node-4 node-1-4
node-1-1 ::= ws "," ws "upper_limit" ws "=" ws node-3 node-1-3 | ws "," ws "multiples" ws "=" ws node-4 node-1-5
node-1-2 ::= ws "," ws "lower_limit" ws "=" ws node-2 node-1-3 | ws "," ws "multiples" ws "=" ws node-4 node-1-6
node-1-3 ::= ws "," ws "multiples" ws "=" ws node-4 node-1-7
node-1-4 ::= ws "," ws "lower_limit" ws "=" ws node-2 node-1-5 | ws "," ws "upper_limit" ws "=" ws node-3 node-1-6
node-1-5 ::= ws "," ws "upper_limit" ws "=" ws node-3 node-1-7
node-1-6 ::= ws "," ws "lower_limit" ws "=" ws node-2 node-1-7
node-1-7 ::= ""
node-7 ::= integer
node-6-0 ::= "count" ws "=" ws node-7 node-6-1
node-6-1 ::= ""
call ::= ("math_toolkit.sum_of_multiples" ws "(" ws node-1-0 ws ")") | ("math_toolkit.product_of_primes" ws "(" ws node-6-0 ws ")")
