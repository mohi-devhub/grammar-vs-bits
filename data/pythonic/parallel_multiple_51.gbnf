root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= string
node-3 ::= string
node-1-0 ::= "team" ws "=" ws node-2 node-1-1 | "info" ws "=" ws node-3 node-1-2
node-1-1 ::= ws "," ws "info" ws "=" ws node-3 node-1-3
node-1-2 ::= ws "," ws "team" ws "=" ws node-2 node-1-3
node-1-3 ::= ""
node-5 ::= string
node-6 ::= string
node-4-0 ::= "player" ws "=" ws node-5 node-4-1 | "stat" ws "=" ws node-6 node-4-2
node-4-1 ::= ws "," ws "stat" ws "=" ws node-6 node-4-3
node-4-2 ::= ws "," ws "player" ws "=" ws node-5 node-4-3
node-4-3 ::= ""
call ::= ("get_team_info" ws "(" ws node-1-0 ws ")") | ("get_player_record" ws "(" ws node-4-0 ws ")")
