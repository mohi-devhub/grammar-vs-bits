root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= string
node-2 ::= "[" ws (node-3 (ws "," ws node-3)*)? ws "]"
node-4 ::= string
node-1-0 ::= "note_sequence" ws "=" ws node-2 node-1-1 | "instrument" ws "=" ws node-4 node-1-2
node-1-1 ::= "" | ws "," ws "instrument" ws "=" ws node-4 node-1-3
node-1-2 ::= ws "," ws "note_sequence" ws "=" ws node-2 node-1-3
node-1-3 ::= ""
node-6 ::= string
node-7 ::= integer
node-8 ::= string
node-5-0 ::= "genre" ws "=" ws node-6 node-5-1 | "bpm" ws "=" ws node-7 node-5-2 | "scale" ws "=" ws node-8 node-5-4
node-5-1 ::= ws "," ws "bpm" ws "=" ws node-7 node-5-3 | ws "," ws "scale" ws "=" ws node-8 node-5-5
node-5-2 ::= ws "," ws "genre" ws "=" ws node-6 node-5-3 | ws "," ws "scale" ws "=" ws node-8 node-5-6
node-5-3 ::= "" | ws "," ws "scale" ws "=" ws node-8 node-5-7
node-5-4 ::= ws "," ws "genre" ws "=" ws node-6 node-5-5 | ws "," ws "bpm" ws "=" ws node-7 node-5-6
node-5-5 ::= ws "," ws "bpm" ws "=" ws node-7 node-5-7
node-5-6 ::= ws "," ws "genre" ws "=" ws node-6 node-5-7
node-5-7 ::= ""
call ::= ("melody_generator" ws "(" ws node-1-0 ws ")") | ("beat_generator" ws "(" ws node-5-0 ws ")")
