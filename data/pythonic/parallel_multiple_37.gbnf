root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= string
node-3 ::= string
node-1-0 ::= "event" ws "=" ws node-2 node-1-1 | "region" ws "=" ws node-3 node-1-2
node-1-1 ::= "" | ws "," ws "region" ws "=" ws node-3 node-1-3
node-1-2 ::= ws "," ws "event" ws "=" ws node-2 node-1-3
node-1-3 ::= ""
node-5 ::= string
node-6 ::= integer
node-4-0 ::= "event" ws "=" ws node-5 node-4-1 | "number" ws "=" ws node-6 node-4-2
node-4-1 ::= "" | ws "," ws "number" ws "=" ws node-6 node-4-3
node-4-2 ::= ws "," ws "event" ws "=" ws node-5 node-4-3
node-4-3 ::= ""
call ::= ("history.get_timeline" ws "(" ws node-1-0 ws ")") | ("history.get_important_figures" ws "(" ws node-4-0 ws ")")
