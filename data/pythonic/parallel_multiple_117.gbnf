root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= string
node-3 ::= string
node-5 ::= "'Backstage Pass'" | "'VIP Seating'" | "'Parking Pass'"
node-4 ::= "[" ws (node-5 (ws "," ws node-5)*)? ws "]"
node-1-0 ::= "artist" ws "=" ws node-2 node-1-1 | "location" ws "=" ws node-3 node-1-2 | "add_ons" ws "=" ws node-4 node-1-4
node-1-1 ::= ws "," ws "location" ws "=" ws node-3 node-1-3 | ws "," ws "add_ons" ws "=" ws node-4 node-1-5
node-1-2 ::= ws "," ws "artist" ws "=" ws node-2 node-1-3 | ws "," ws "add_ons" ws "=" ws node-4 node-1-6
node-1-3 ::= "" | ws "," ws "add_ons" ws "=" ws node-4 node-1-7
node-1-4 ::= ws "," ws "artist" ws "=" ws node-2 node-1-5 | ws "," ws "location" ws "=" ws node-3 node-1-6
node-1-5 ::= ws "," ws "location" ws "=" ws node-3 node-1-7
node-1-6 ::= ws "," ws "artist" ws "=" ws node-2 node-1-7
node-1-7 ::= ""
node-7 ::= string
node-8 ::= string
node-10 ::= "'Camping Pass'" | "'VIP Seating'" | "'Parking Pass'"
node-9 ::= "[" ws (node-10 (ws "," ws node-10)*)? ws "]"
node-6-0 ::= "festival" ws "=" ws node-7 node-6-1 | "location" ws "=" ws node-8 node-6-2 | "add_ons" ws "=" ws node-9 node-6-4
node-6-1 ::= ws "," ws "location" ws "=" ws node-8 node-6-3 | ws "," ws "add_ons" ws "=" ws node-9 node-6-5
node-6-2 ::= ws "," ws "festival" ws "=" ws node-7 node-6-3 | ws "," ws "add_ons" ws "=" ws node-9 node-6-6
node-6-3 ::= "" | ws "," ws "add_ons" ws "=" ws node-9 node-6-7
node-6-4 ::= ws "," ws "festival" ws "=" ws node-7 node-6-5 | ws "," ws "location" ws "=" ws node-8 node-6-6
node-6-5 ::= ws "," ws "location" ws "=" ws node-8 node-6-7
node-6-6 ::= ws "," ws "festival" ws "=" ws node-7 node-6-7
node-6-7 ::= ""
call ::= ("concert.book_ticket" ws "(" ws node-1-0 ws ")") | ("festival.book_ticket" ws "(" ws node-6-0 ws ")")
