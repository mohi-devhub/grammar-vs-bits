root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= integer
node-3 ::= "'popularity'" | "'chronological'" | "'alphabetical'"
node-1-0 ::= "number" ws "=" ws node-2 node-1-1 | "sort_by" ws "=" ws node-3 node-1-2
node-1-1 ::= "" | ws "," ws "sort_by" ws "=" ws node-3 node-1-3
node-1-2 ::= ws "," ws "number" ws "=" ws node-2 node-1-3
node-1-3 ::= ""
node-5 ::= string
node-6 ::= string
node-7 ::= string
node-8 ::= "'ongoing'" | "'settled'" | "'dismissed'"
node-4-0 ::= "company" ws "=" ws node-5 node-4-1 | "start_date" ws "=" ws node-6 node-4-2 | "location" ws "=" ws node-7 node-4-4 | "status" ws "=" ws node-8 node-4-8
node-4-1 ::= ws "," ws "start_date" ws "=" ws node-6 node-4-3 | ws "," ws "location" ws "=" ws node-7 node-4-5 | ws "," ws "status" ws "=" ws node-8 node-4-9
node-4-2 ::= ws "," ws "company" ws "=" ws node-5 node-4-3 | ws "," ws "location" ws "=" ws node-7 node-4-6 | ws "," ws "status" ws "=" ws node-8 node-4-10
node-4-3 ::= ws "," ws "location" ws "=" ws node-7 node-4-7 | ws "," ws "status" ws "=" ws node-8 node-4-11
node-4-4 ::= ws "," ws "company" ws "=" ws node-5 node-4-5 | ws "," ws "start_date" ws "=" ws node-6 node-4-6 | ws "," ws "status" ws "=" ws node-8 node-4-12
node-4-5 ::= ws "," ws "start_date" ws "=" ws node-6 node-4-7 | ws "," ws "status" ws "=" ws node-8 node-4-13
node-4-6 ::= ws "," ws "company" ws "=" ws node-5 node-4-7 | ws "," ws "status" ws "=" ws node-8 node-4-14
node-4-7 ::= "" | ws "," ws "status" ws "=" ws node-8 node-4-15
node-4-8 ::= ws "," ws "company" ws "=" ws node-5 node-4-9 | ws "," ws "start_date" ws "=" ws node-6 node-4-10 | ws "," ws "location" ws "=" ws node-7 node-4-12
node-4-9 ::= ws "," ws "start_date" ws "=" ws node-6 node-4-11 | ws "," ws "location" ws "=" ws node-7 node-4-13
node-4-10 ::= ws "," ws "company" ws "=" ws node-5 node-4-11 | ws "," ws "location" ws "=" ws node-7 node-4-14
node-4-11 ::= ws "," ws "location" ws "=" ws node-7 node-4-15
node-4-12 ::= ws "," ws "company" ws "=" ws node-5 node-4-13 | ws "," ws "start_date" ws "=" ws node-6 node-4-14
node-4-13 ::= ws "," ws "start_date" ws "=" ws node-6 node-4-15
node-4-14 ::= ws "," ws "company" ws "=" ws node-5 node-4-15
node-4-15 ::= ""
call ::= ("metropolitan_museum.get_top_artworks" ws "(" ws node-1-0 ws ")") | ("lawsuit_search" ws "(" ws node-4-0 ws ")")
