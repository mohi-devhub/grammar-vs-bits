node-9-9 ::= ws "," ws "depreciation_rate" ws "=" ws node-11 node-9-11 | ws "," ws "years" ws "=" ws node-12 node-9-13
node-9-10 ::= ws "," ws "initial_cost" ws "=" ws node-10 node-9-11 | ws "," ws "years" ws "=" ws node-12 node-9-14
