node-9-13 ::= ws "," ws "depreciation_rate" ws "=" ws node-11 node-9-15
node-9-14 ::= ws "," ws "initial_cost" ws "=" ws node-10 node-9-15
node-9-15 ::= ""
call ::= ("finance.loan_repayment" ws "(" ws node-1-0 ws ")") | ("finance.inflation_adjustment" ws "(" ws node-5-0 ws ")") | ("finance.property_depreciation" ws "(" ws node-9-0 ws ")")
