root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= number
node-3 ::= number
node-4 ::= integer
node-1-0 ::= "loan_amount" ws "=" ws node-2 node-1-1 | "interest_rate" ws "=" ws node-3 node-1-2 | "loan_term" ws "=" ws node-4 node-1-4
node-1-1 ::= ws "," ws "interest_rate" ws "=" ws node-3 node-1-3 | ws "," ws "loan_term" ws "=" ws node-4 node-1-5
node-1-2 ::= ws "," ws "loan_amount" ws "=" ws node-2 node-1-3 | ws "," ws "loan_term" ws "=" ws node-4 node-1-6
node-1-3 ::= ws "," ws "loan_term" ws "=" ws node-4 node-1-7
node-1-4 ::= ws "," ws "loan_amount" ws "=" ws node-2 node-1-5 | ws "," ws "interest_rate" ws "=" ws node-3 node-1-6
node-1-5 ::= ws "," ws "interest_rate" ws "=" ws node-3 node-1-7
node-1-6 ::= ws "," ws "loan_amount" ws "=" ws node-2 node-1-7
node-1-7 ::= ""
node-6 ::= number
node-7 ::= integer
node-8 ::= number
node-5-0 ::= "initial_sum" ws "=" ws node-6 node-5-1 | "years" ws "=" ws node-7 node-5-2 | "inflation_rate" ws "=" ws node-8 node-5-4
node-5-1 ::= ws "," ws "years" ws "=" ws node-7 node-5-3 | ws "," ws "inflation_rate" ws "=" ws node-8 node-5-5
node-5-2 ::= ws "," ws "initial_sum" ws "=" ws node-6 node-5-3 | ws "," ws "inflation_rate" ws "=" ws node-8 node-5-6
node-5-3 ::= ws "," ws "inflation_rate" ws "=" ws node-8 node-5-7
node-5-4 ::= ws "," ws "initial_sum" ws "=" ws node-6 node-5-5 | ws "," ws "years" ws "=" ws node-7 node-5-6
node-5-5 ::= ws "," ws "years" ws "=" ws node-7 node-5-7
node-5-6 ::= ws "," ws "initial_sum" ws "=" ws node-6 node-5-7
node-5-7 ::= ""
node-10 ::= number
node-11 ::= number
node-12 ::= integer
node-13 ::= boolean
node-9-0 ::= "initial_cost" ws "=" ws node-10 node-9-1 | "depreciation_rate" ws "=" ws node-11 node-9-2 | "years" ws "=" ws node-12 node-9-4 | "monthly" ws "=" ws node-13 node-9-8
node-9-1 ::= ws "," ws "depreciation_rate" ws "=" ws node-11 node-9-3 | ws "," ws "years" ws "=" ws node-12 node-9-5 | ws "," ws "monthly" ws "=" ws node-13 node-9-9
node-9-2 ::= ws "," ws "initial_cost" ws "=" ws node-10 node-9-3 | ws "," ws "years" ws "=" ws node-12 node-9-6 | ws "," ws "monthly" ws "=" ws node-13 node-9-10
node-9-3 ::= ws "," ws "years" ws "=" ws node-12 node-9-7 | ws "," ws "monthly" ws "=" ws node-13 node-9-11
node-9-4 ::= ws "," ws "initial_cost" ws "=" ws node-10 node-9-5 | ws "," ws "depreciation_rate" ws "=" ws node-11 node-9-6 | ws "," ws "monthly" ws "=" ws node-13 node-9-12
node-9-5 ::= ws "," ws "depreciation_rate" ws "=" ws node-11 node-9-7 | ws "," ws "monthly" ws "=" ws node-13 node-9-13
