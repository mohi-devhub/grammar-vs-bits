root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= string
node-2 ::= "[" ws (node-3 (ws "," ws node-3)*)? ws "]"
node-4 ::= integer
node-5 ::= string
node-1-0 ::= "ingredients" ws "=" ws node-2 node-1-1 | "calories" ws "=" ws node-4 node-1-2 | "meal" ws "=" ws node-5 node-1-4
node-1-1 ::= ws "," ws "calories" ws "=" ws node-4 node-1-3 | ws "," ws "meal" ws "=" ws node-5 node-1-5
node-1-2 ::= ws "," ws "ingredients" ws "=" ws node-2 node-1-3 | ws "," ws "meal" ws "=" ws node-5 node-1-6
node-1-3 ::= "" | ws "," ws "meal" ws "=" ws node-5 node-1-7
node-1-4 ::= ws "," ws "ingredients" ws "=" ws node-2 node-1-5 | ws "," ws "calories" ws "=" ws node-4 node-1-6
node-1-5 ::= ws "," ws "calories" ws "=" ws node-4 node-1-7
node-1-6 ::= ws "," ws "ingredients" ws "=" ws node-2 node-1-7
node-1-7 ::= ""
node-7 ::= string
node-8 ::= string
node-9 ::= integer
node-6-0 ::= "original_ingredient" ws "=" ws node-7 node-6-1 | "replacement_ingredient" ws "=" ws node-8 node-6-2 | "calories" ws "=" ws node-9 node-6-4
node-6-1 ::= ws "," ws "replacement_ingredient" ws "=" ws node-8 node-6-3 | ws "," ws "calories" ws "=" ws node-9 node-6-5
node-6-2 ::= ws "," ws "original_ingredient" ws "=" ws node-7 node-6-3 | ws "," ws "calories" ws "=" ws node-9 node-6-6
node-6-3 ::= ws "," ws "calories" ws "=" ws node-9 node-6-7
node-6-4 ::= ws "," ws "original_ingredient" ws "=" ws node-7 node-6-5 | ws "," ws "replacement_ingredient" ws "=" ws node-8 node-6-6
node-6-5 ::= ws "," ws "replacement_ingredient" ws "=" ws node-8 node-6-7
node-6-6 ::= ws "," ws "original_ingredient" ws "=" ws node-7 node-6-7
node-6-7 ::= ""
node-12 ::= string
node-11 ::= "[" ws (node-12 (ws "," ws node-12)*)? ws "]"
node-13 ::= integer
node-14 ::= string
node-10-0 ::= "ingredients" ws "=" ws node-11 node-10-1 | "calories" ws "=" ws node-13 node-10-2 | "meal" ws "=" ws node-14 node-10-4
node-10-1 ::= ws "," ws "calories" ws "=" ws node-13 node-10-3 | ws "," ws "meal" ws "=" ws node-14 node-10-5
node-10-2 ::= ws "," ws "ingredients" ws "=" ws node-11 node-10-3 | ws "," ws "meal" ws "=" ws node-14 node-10-6
node-10-3 ::= "" | ws "," ws "meal" ws "=" ws node-14 node-10-7
node-10-4 ::= ws "," ws "ingredients" ws "=" ws node-11 node-10-5 | ws "," ws "calories" ws "=" ws node-13 node-10-6
node-10-5 ::= ws "," ws "calories" ws "=" ws node-13 node-10-7
node-10-6 ::= ws "," ws "ingredients" ws "=" ws node-11 node-10-7
node-10-7 ::= ""
call ::= ("recipe_search" ws "(" ws node-1-0 ws ")") | ("ingredient_replace" ws "(" ws node-6-0 ws ")") | ("restaurant_search" ws "(" ws node-10-0 ws ")")
