root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= value
node-4 ::= value
node-5 ::= value
node-2-s-0 ::= ("\"adults\"" | "'adults'") ws ":" ws node-3 node-2-s-1 | ("\"children\"" | "'children'") ws ":" ws node-4 node-2-s-2 | ("\"singles\"" | "'singles'") ws ":" ws node-5 node-2-s-4
node-2-s-1 ::= ws "," ws ("\"children\"" | "'children'") ws ":" ws node-4 node-2-s-3 | ws "," ws ("\"singles\"" | "'singles'") ws ":" ws node-5 node-2-s-5
node-2-s-2 ::= ws "," ws ("\"adults\"" | "'adults'") ws ":" ws node-3 node-2-s-3 | ws "," ws ("\"singles\"" | "'singles'") ws ":" ws node-5 node-2-s-6
node-2-s-3 ::= ws "," ws ("\"singles\"" | "'singles'") ws ":" ws node-5 node-2-s-7
node-2-s-4 ::= ws "," ws ("\"adults\"" | "'adults'") ws ":" ws node-3 node-2-s-5 | ws "," ws ("\"children\"" | "'children'") ws ":" ws node-4 node-2-s-6
node-2-s-5 ::= ws "," ws ("\"children\"" | "'children'") ws ":" ws node-4 node-2-s-7
node-2-s-6 ::= ws "," ws ("\"adults\"" | "'adults'") ws ":" ws node-3 node-2-s-7
node-2-s-7 ::= ""
node-2 ::= "{" ws node-2-s-0 ws "}"
node-6 ::= string
node-1-0 ::= "population" ws "=" ws node-2 node-1-1 | "location" ws "=" ws node-6 node-1-2
node-1-1 ::= ws "," ws "location" ws "=" ws node-6 node-1-3
node-1-2 ::= ws "," ws "population" ws "=" ws node-2 node-1-3
node-1-3 ::= ""
call ::= ("waste_calculation.calculate" ws "(" ws node-1-0 ws ")")
