root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= string
node-3 ::= number
node-1-0 ::= "account_id" ws "=" ws node-2 node-1-1 | "amount" ws "=" ws node-3 node-1-2
node-1-1 ::= ws "," ws "amount" ws "=" ws node-3 node-1-3
node-1-2 ::= ws "," ws "account_id" ws "=" ws node-2 node-1-3
node-1-3 ::= ""
node-5 ::= number
node-6 ::= string
node-7 ::= string
node-4-0 ::= "amount" ws "=" ws node-5 node-4-1 | "from_currency" ws "=" ws node-6 node-4-2 | "to_currency" ws "=" ws node-7 node-4-4
node-4-1 ::= ws "," ws "from_currency" ws "=" ws node-6 node-4-3 | ws "," ws "to_currency" ws "=" ws node-7 node-4-5
node-4-2 ::= ws "," ws "amount" ws "=" ws node-5 node-4-3 | ws "," ws "to_currency" ws "=" ws node-7 node-4-6
node-4-3 ::= ws "," ws "to_currency" ws "=" ws node-7 node-4-7
node-4-4 ::= ws "," ws "amount" ws "=" ws node-5 node-4-5 | ws "," ws "from_currency" ws "=" ws node-6 node-4-6
node-4-5 ::= ws "," ws "from_currency" ws "=" ws node-6 node-4-7
node-4-6 ::= ws "," ws "amount" ws "=" ws node-5 node-4-7
node-4-7 ::= ""
call ::= ("banking_service" ws "(" ws node-1-0 ws ")") | ("currency_conversion" ws "(" ws node-4-0 ws ")")
