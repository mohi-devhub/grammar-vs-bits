root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= string
node-3 ::= integer
node-4 ::= integer
node-5 ::= string
node-1-0 ::= "key" ws "=" ws node-2 node-1-1 | "tempo" ws "=" ws node-3 node-1-2 | "duration" ws "=" ws node-4 node-1-4 | "scale_type" ws "=" ws node-5 node-1-8
node-1-1 ::= ws "," ws "tempo" ws "=" ws node-3 node-1-3 | ws "," ws "duration" ws "=" ws node-4 node-1-5 | ws "," ws "scale_type" ws "=" ws node-5 node-1-9
node-1-2 ::= ws "," ws "key" ws "=" ws node-2 node-1-3 | ws "," ws "duration" ws "=" ws node-4 node-1-6 | ws "," ws "scale_type" ws "=" ws node-5 node-1-10
node-1-3 ::= ws "," ws "duration" ws "=" ws node-4 node-1-7 | ws "," ws "scale_type" ws "=" ws node-5 node-1-11
node-1-4 ::= ws "," ws "key" ws "=" ws node-2 node-1-5 | ws "," ws "tempo" ws "=" ws node-3 node-1-6 | ws "," ws "scale_type" ws "=" ws node-5 node-1-12
node-1-5 ::= ws "," ws "tempo" ws "=" ws node-3 node-1-7 | ws "," ws "scale_type" ws "=" ws node-5 node-1-13
node-1-6 ::= ws "," ws "key" ws "=" ws node-2 node-1-7 | ws "," ws "scale_type" ws "=" ws node-5 node-1-14
node-1-7 ::= "" | ws "," ws "scale_type" ws "=" ws node-5 node-1-15
node-1-8 ::= ws "," ws "key" ws "=" ws node-2 node-1-9 | ws "," ws "tempo" ws "=" ws node-3 node-1-10 | ws "," ws "duration" ws "=" ws node-4 node-1-12
node-1-9 ::= ws "," ws "tempo" ws "=" ws node-3 node-1-11 | ws "," ws "duration" ws "=" ws node-4 node-1-13
node-1-10 ::= ws "," ws "key" ws "=" ws node-2 node-1-11 | ws "," ws "duration" ws "=" ws node-4 node-1-14
node-1-11 ::= ws "," ws "duration" ws "=" ws node-4 node-1-15
node-1-12 ::= ws "," ws "key" ws "=" ws node-2 node-1-13 | ws "," ws "tempo" ws "=" ws node-3 node-1-14
node-1-13 ::= ws "," ws "tempo" ws "=" ws node-3 node-1-15
node-1-14 ::= ws "," ws "key" ws "=" ws node-2 node-1-15
node-1-15 ::= ""
node-7 ::= integer
node-8 ::= integer
node-6-0 ::= "number1" ws "=" ws node-7 node-6-1 | "number2" ws "=" ws node-8 node-6-2
node-6-1 ::= ws "," ws "number2" ws "=" ws node-8 node-6-3
node-6-2 ::= ws "," ws "number1" ws "=" ws node-7 node-6-3
node-6-3 ::= ""
call ::= ("music_generator.generate_scale_progression" ws "(" ws node-1-0 ws ")") | ("math.hcf" ws "(" ws node-6-0 ws ")")
