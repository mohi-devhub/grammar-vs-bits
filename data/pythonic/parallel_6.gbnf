root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= number
node-3 ::= string
node-4 ::= string
node-1-0 ::= "purchase_amount" ws "=" ws node-2 node-1-1 | "city" ws "=" ws node-3 node-1-2 | "state" ws "=" ws node-4 node-1-4
node-1-1 ::= ws "," ws "city" ws "=" ws node-3 node-1-3 | ws "," ws "state" ws "=" ws node-4 node-1-5
node-1-2 ::= ws "," ws "purchase_amount" ws "=" ws node-2 node-1-3 | ws "," ws "state" ws "=" ws node-4 node-1-6
node-1-3 ::= ws "," ws "state" ws "=" ws node-4 node-1-7
node-1-4 ::= ws "," ws "purchase_amount" ws "=" ws node-2 node-1-5 | ws "," ws "city" ws "=" ws node-3 node-1-6
node-1-5 ::= ws "," ws "city" ws "=" ws node-3 node-1-7
node-1-6 ::= ws "," ws "purchase_amount" ws "=" ws node-2 node-1-7
node-1-7 ::= ""
call ::= ("calculate_sales_tax" ws "(" ws node-1-0 ws ")")
