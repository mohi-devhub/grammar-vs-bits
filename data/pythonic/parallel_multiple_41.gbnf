root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= string
node-3 ::= string
node-5 ::= integer
node-4 ::= "[" ws (node-5 (ws "," ws node-5)*)? ws "]"
node-1-0 ::= "shape" ws "=" ws node-2 node-1-1 | "background_color" ws "=" ws node-3 node-1-2 | "dimensions" ws "=" ws node-4 node-1-4
node-1-1 ::= ws "," ws "background_color" ws "=" ws node-3 node-1-3 | ws "," ws "dimensions" ws "=" ws node-4 node-1-5
node-1-2 ::= ws "," ws "shape" ws "=" ws node-2 node-1-3 | ws "," ws "dimensions" ws "=" ws node-4 node-1-6
node-1-3 ::= ws "," ws "dimensions" ws "=" ws node-4 node-1-7
node-1-4 ::= ws "," ws "shape" ws "=" ws node-2 node-1-5 | ws "," ws "background_color" ws "=" ws node-3 node-1-6
node-1-5 ::= ws "," ws "background_color" ws "=" ws node-3 node-1-7
node-1-6 ::= ws "," ws "shape" ws "=" ws node-2 node-1-7
node-1-7 ::= ""
node-7 ::= integer
node-8 ::= integer
node-6-0 ::= "percentage" ws "=" ws node-7 node-6-1 | "duration" ws "=" ws node-8 node-6-2
node-6-1 ::= ws "," ws "duration" ws "=" ws node-8 node-6-3
node-6-2 ::= ws "," ws "percentage" ws "=" ws node-7 node-6-3
node-6-3 ::= ""
node-10 ::= integer
node-9-0 ::= "time" ws "=" ws node-10 node-9-1
node-9-1 ::= ""
call ::= ("painting.create" ws "(" ws node-1-0 ws ")") | ("display.set_screen_brightness" ws "(" ws node-6-0 ws ")") | ("painting.display" ws "(" ws node-9-0 ws ")")
