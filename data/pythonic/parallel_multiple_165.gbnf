node-10-0 ::= "items" ws "=" ws node-11 node-10-1 | "quantities" ws "=" ws node-13 node-10-2 | "store_location" ws "=" ws node-15 node-10-4
node-10-1 ::= ws "," ws "quantities" ws "=" ws node-13 node-10-3 | ws "," ws "store_location" ws "=" ws node-15 node-10-5
node-10-2 ::= ws "," ws "items" ws "=" ws node-11 node-10-3 | ws "," ws "store_location" ws "=" ws node-15 node-10-6
