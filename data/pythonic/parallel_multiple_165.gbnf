root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= string
node-3 ::= string
node-4 ::= integer
node-1-0 ::= "location" ws "=" ws node-2 node-1-1 | "genre" ws "=" ws node-3 node-1-2 | "days_ahead" ws "=" ws node-4 node-1-4
node-1-1 ::= ws "," ws "genre" ws "=" ws node-3 node-1-3 | ws "," ws "days_ahead" ws "=" ws node-4 node-1-5
node-1-2 ::= ws "," ws "location" ws "=" ws node-2 node-1-3 | ws "," ws "days_ahead" ws "=" ws node-4 node-1-6
node-1-3 ::= "" | ws "," ws "days_ahead" ws "=" ws node-4 node-1-7
node-1-4 ::= ws "," ws "location" ws "=" ws node-2 node-1-5 | ws "," ws "genre" ws "=" ws node-3 node-1-6
node-1-5 ::= ws "," ws "genre" ws "=" ws node-3 node-1-7
node-1-6 ::= ws "," ws "location" ws "=" ws node-2 node-1-7
node-1-7 ::= ""
node-6 ::= string
node-7 ::= string
node-8 ::= string
node-9 ::= "'ongoing'" | "'settled'" | "'dismissed'"
node-5-0 ::= "company" ws "=" ws node-6 node-5-1 | "start_date" ws "=" ws node-7 node-5-2 | "location" ws "=" ws node-8 node-5-4 | "status" ws "=" ws node-9 node-5-8
node-5-1 ::= ws "," ws "start_date" ws "=" ws node-7 node-5-3 | ws "," ws "location" ws "=" ws node-8 node-5-5 | ws "," ws "status" ws "=" ws node-9 node-5-9
node-5-2 ::= ws "," ws "company" ws "=" ws node-6 node-5-3 | ws "," ws "location" ws "=" ws node-8 node-5-6 | ws "," ws "status" ws "=" ws node-9 node-5-10
node-5-3 ::= ws "," ws "location" ws "=" ws node-8 node-5-7 | ws "," ws "status" ws "=" ws node-9 node-5-11
node-5-4 ::= ws "," ws "company" ws "=" ws node-6 node-5-5 | ws "," ws "start_date" ws "=" ws node-7 node-5-6 | ws "," ws "status" ws "=" ws node-9 node-5-12
node-5-5 ::= ws "," ws "start_date" ws "=" ws node-7 node-5-7 | ws "," ws "status" ws "=" ws node-9 node-5-13
node-5-6 ::= ws "," ws "company" ws "=" ws node-6 node-5-7 | ws "," ws "status" ws "=" ws node-9 node-5-14
node-5-7 ::= "" | ws "," ws "status" ws "=" ws node-9 node-5-15
node-5-8 ::= ws "," ws "company" ws "=" ws node-6 node-5-9 | ws "," ws "start_date" ws "=" ws node-7 node-5-10 | ws "," ws "location" ws "=" ws node-8 node-5-12
node-5-9 ::= ws "," ws "start_date" ws "=" ws node-7 node-5-11 | ws "," ws "location" ws "=" ws node-8 node-5-13
node-5-10 ::= ws "," ws "company" ws "=" ws node-6 node-5-11 | ws "," ws "location" ws "=" ws node-8 node-5-14
node-5-11 ::= ws "," ws "location" ws "=" ws node-8 node-5-15
node-5-12 ::= ws "," ws "company" ws "=" ws node-6 node-5-13 | ws "," ws "start_date" ws "=" ws node-7 node-5-14
node-5-13 ::= ws "," ws "start_date" ws "=" ws node-7 node-5-15
node-5-14 ::= ws "," ws "company" ws "=" ws node-6 node-5-15
node-5-15 ::= ""
node-12 ::= string
node-11 ::= "[" ws (node-12 (ws "," ws node-12)*)? ws "]"
node-14 ::= integer
node-13 ::= "[" ws (node-14 (ws "," ws node-14)*)? ws "]"
