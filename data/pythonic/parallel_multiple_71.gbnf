root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= string
node-3 ::= string
node-1-0 ::= "sculpture_name" ws "=" ws node-2 node-1-1 | "material" ws "=" ws node-3 node-1-2
node-1-1 ::= ws "," ws "material" ws "=" ws node-3 node-1-3
node-1-2 ::= ws "," ws "sculpture_name" ws "=" ws node-2 node-1-3
node-1-3 ::= ""
node-5 ::= string
node-4-0 ::= "name" ws "=" ws node-5 node-4-1
node-4-1 ::= ""
node-7 ::= string
node-8 ::= integer
node-9 ::= "'low'" | "'medium'" | "'high'"
node-6-0 ::= "material" ws "=" ws node-7 node-6-1 | "size" ws "=" ws node-8 node-6-2 | "complexity" ws "=" ws node-9 node-6-4
node-6-1 ::= ws "," ws "size" ws "=" ws node-8 node-6-3 | ws "," ws "complexity" ws "=" ws node-9 node-6-5
node-6-2 ::= ws "," ws "material" ws "=" ws node-7 node-6-3 | ws "," ws "complexity" ws "=" ws node-9 node-6-6
node-6-3 ::= "" | ws "," ws "complexity" ws "=" ws node-9 node-6-7
node-6-4 ::= ws "," ws "material" ws "=" ws node-7 node-6-5 | ws "," ws "size" ws "=" ws node-8 node-6-6
node-6-5 ::= ws "," ws "size" ws "=" ws node-8 node-6-7
node-6-6 ::= ws "," ws "material" ws "=" ws node-7 node-6-7
node-6-7 ::= ""
call ::= ("sculpture_availability.check" ws "(" ws node-1-0 ws ")") | ("sculptor_info.get" ws "(" ws node-4-0 ws ")") | ("sculpture_price.calculate" ws "(" ws node-6-0 ws ")")
