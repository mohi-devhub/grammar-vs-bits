root ::= ws "[" ws (call (ws "," ws call)*)? ws "]" ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "\"" | "'" ([^'\\\x00-\x1F] | "\\" (["'\\abfnrtv] | "u" [0-9a-fA-F]{4} | "x" [0-9a-fA-F]{2}))* "'"
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "True" | "False"
null ::= "None"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-2 ::= string
node-1-0 ::= "movie_name" ws "=" ws node-2 node-1-1
node-1-1 ::= ""
node-4 ::= string
node-5 ::= string
node-3-0 ::= "case_id" ws "=" ws node-4 node-3-1 | "summary_type" ws "=" ws node-5 node-3-2
node-3-1 ::= "" | ws "," ws "summary_type" ws "=" ws node-5 node-3-3
node-3-2 ::= ws "," ws "case_id" ws "=" ws node-4 node-3-3
node-3-3 ::= ""
node-7 ::= string
node-8 ::= string
node-6-0 ::= "party_name" ws "=" ws node-7 node-6-1 | "city" ws "=" ws node-8 node-6-2
node-6-1 ::= ws "," ws "city" ws "=" ws node-8 node-6-3
node-6-2 ::= ws "," ws "party_name" ws "=" ws node-7 node-6-3
node-6-3 ::= ""
call ::= ("movie_ratings.get_movie" ws "(" ws node-1-0 ws ")") | ("legal_case.get_summary" ws "(" ws node-3-0 ws ")") | ("legal_case.find_parties" ws "(" ws node-6-0 ws ")")
