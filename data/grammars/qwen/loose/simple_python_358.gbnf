root ::= strict | unrestricted
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "true" | "false"
null ::= "null"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= "\"recipe_search\""
node-6 ::= "\"Gluten Free\"" | "\"Dairy Free\"" | "\"Vegan\"" | "\"Vegetarian\""
node-5 ::= "[" ws (node-6 (ws "," ws node-6)*)? ws "]"
node-7 ::= integer
node-8 ::= string
node-4-s-0 ::= "\"diet\"" ws ":" ws node-5 node-4-s-1 | "\"time_limit\"" ws ":" ws node-7 node-4-s-2 | "\"dish\"" ws ":" ws node-8 node-4-s-4
node-4-s-1 ::= ws "," ws "\"time_limit\"" ws ":" ws node-7 node-4-s-3 | ws "," ws "\"dish\"" ws ":" ws node-8 node-4-s-5
node-4-s-2 ::= ws "," ws "\"diet\"" ws ":" ws node-5 node-4-s-3 | ws "," ws "\"dish\"" ws ":" ws node-8 node-4-s-6
node-4-s-3 ::= ws "," ws "\"dish\"" ws ":" ws node-8 node-4-s-7
node-4-s-4 ::= ws "," ws "\"diet\"" ws ":" ws node-5 node-4-s-5 | ws "," ws "\"time_limit\"" ws ":" ws node-7 node-4-s-6
node-4-s-5 ::= "" | ws "," ws "\"time_limit\"" ws ":" ws node-7 node-4-s-7
node-4-s-6 ::= ws "," ws "\"diet\"" ws ":" ws node-5 node-4-s-7
node-4-s-7 ::= ""
node-4 ::= "{" ws node-4-s-0 ws "}"
node-2-s-0 ::= "\"name\"" ws ":" ws node-3 node-2-s-1 | "\"arguments\"" ws ":" ws node-4 node-2-s-2
node-2-s-1 ::= ws "," ws "\"arguments\"" ws ":" ws node-4 node-2-s-3
node-2-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-3 node-2-s-3
node-2-s-3 ::= ""
node-2 ::= "{" ws node-2-s-0 ws "}"
node-1 ::= node-2
call ::= "<tool_call>" ws node-1 ws "</tool_call>"
unrestricted ::= .*
strict ::= ws ("NO_CALL" | call (ws call)*) ws
