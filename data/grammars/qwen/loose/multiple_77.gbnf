node-13-s-0 ::= "\"name\"" ws ":" ws node-14 node-13-s-1 | "\"arguments\"" ws ":" ws node-15 node-13-s-2
node-13-s-1 ::= ws "," ws "\"arguments\"" ws ":" ws node-15 node-13-s-3
node-13-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-14 node-13-s-3
node-13-s-3 ::= ""
node-13 ::= "{" ws node-13-s-0 ws "}"
node-1 ::= node-2 | node-7 | node-13
call ::= "<tool_call>" ws node-1 ws "</tool_call>"
unrestricted ::= .*
strict ::= ws ("NO_CALL" | call (ws call)*) ws
