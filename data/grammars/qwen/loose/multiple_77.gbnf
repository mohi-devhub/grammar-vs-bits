root ::= strict | unrestricted
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "true" | "false"
null ::= "null"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= "\"tourist_attraction.find\""
node-5 ::= string
node-6 ::= string
node-4-s-0 ::= "\"attractionType\"" ws ":" ws node-5 node-4-s-1 | "\"location\"" ws ":" ws node-6 node-4-s-2
node-4-s-1 ::= ws "," ws "\"location\"" ws ":" ws node-6 node-4-s-3
node-4-s-2 ::= ws "," ws "\"attractionType\"" ws ":" ws node-5 node-4-s-3
node-4-s-3 ::= ""
node-4 ::= "{" ws node-4-s-0 ws "}"
node-2-s-0 ::= "\"name\"" ws ":" ws node-3 node-2-s-1 | "\"arguments\"" ws ":" ws node-4 node-2-s-2
node-2-s-1 ::= ws "," ws "\"arguments\"" ws ":" ws node-4 node-2-s-3
node-2-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-3 node-2-s-3
node-2-s-3 ::= ""
node-2 ::= "{" ws node-2-s-0 ws "}"
node-8 ::= "\"artwork_search.find\""
node-10 ::= string
node-11 ::= string
node-12 ::= string
node-9-s-0 ::= "\"type\"" ws ":" ws node-10 node-9-s-1 | "\"location\"" ws ":" ws node-11 node-9-s-2 | "\"era\"" ws ":" ws node-12 node-9-s-4
node-9-s-1 ::= ws "," ws "\"location\"" ws ":" ws node-11 node-9-s-3 | ws "," ws "\"era\"" ws ":" ws node-12 node-9-s-5
node-9-s-2 ::= ws "," ws "\"type\"" ws ":" ws node-10 node-9-s-3 | ws "," ws "\"era\"" ws ":" ws node-12 node-9-s-6
node-9-s-3 ::= "" | ws "," ws "\"era\"" ws ":" ws node-12 node-9-s-7
node-9-s-4 ::= ws "," ws "\"type\"" ws ":" ws node-10 node-9-s-5 | ws "," ws "\"location\"" ws ":" ws node-11 node-9-s-6
node-9-s-5 ::= ws "," ws "\"location\"" ws ":" ws node-11 node-9-s-7
node-9-s-6 ::= ws "," ws "\"type\"" ws ":" ws node-10 node-9-s-7
node-9-s-7 ::= ""
node-9 ::= "{" ws node-9-s-0 ws "}"
node-7-s-0 ::= "\"name\"" ws ":" ws node-8 node-7-s-1 | "\"arguments\"" ws ":" ws node-9 node-7-s-2
node-7-s-1 ::= ws "," ws "\"arguments\"" ws ":" ws node-9 node-7-s-3
node-7-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-8 node-7-s-3
node-7-s-3 ::= ""
node-7 ::= "{" ws node-7-s-0 ws "}"
node-14 ::= "\"park_search.find\""
node-17 ::= string
node-16 ::= "[" ws (node-17 (ws "," ws node-17)*)? ws "]"
node-18 ::= string
node-15-s-0 ::= "\"facilities\"" ws ":" ws node-16 node-15-s-1 | "\"location\"" ws ":" ws node-18 node-15-s-2
node-15-s-1 ::= ws "," ws "\"location\"" ws ":" ws node-18 node-15-s-3
node-15-s-2 ::= ws "," ws "\"facilities\"" ws ":" ws node-16 node-15-s-3
node-15-s-3 ::= ""
