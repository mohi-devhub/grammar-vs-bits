root ::= strict | unrestricted
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "true" | "false"
null ::= "null"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= "\"sculpture_locator.find_by_artist\""
node-5 ::= string
node-6 ::= string
node-7 ::= string
node-4-s-0 ::= "\"artist\"" ws ":" ws node-5 node-4-s-1 | "\"material\"" ws ":" ws node-6 node-4-s-2 | "\"location\"" ws ":" ws node-7 node-4-s-4
node-4-s-1 ::= ws "," ws "\"material\"" ws ":" ws node-6 node-4-s-3 | ws "," ws "\"location\"" ws ":" ws node-7 node-4-s-5
node-4-s-2 ::= ws "," ws "\"artist\"" ws ":" ws node-5 node-4-s-3 | ws "," ws "\"location\"" ws ":" ws node-7 node-4-s-6
node-4-s-3 ::= "" | ws "," ws "\"location\"" ws ":" ws node-7 node-4-s-7
node-4-s-4 ::= ws "," ws "\"artist\"" ws ":" ws node-5 node-4-s-5 | ws "," ws "\"material\"" ws ":" ws node-6 node-4-s-6
node-4-s-5 ::= ws "," ws "\"material\"" ws ":" ws node-6 node-4-s-7
node-4-s-6 ::= ws "," ws "\"artist\"" ws ":" ws node-5 node-4-s-7
node-4-s-7 ::= ""
node-4 ::= "{" ws node-4-s-0 ws "}"
node-2-s-0 ::= "\"name\"" ws ":" ws node-3 node-2-s-1 | "\"arguments\"" ws ":" ws node-4 node-2-s-2
node-2-s-1 ::= ws "," ws "\"arguments\"" ws ":" ws node-4 node-2-s-3
node-2-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-3 node-2-s-3
node-2-s-3 ::= ""
node-2 ::= "{" ws node-2-s-0 ws "}"
node-1 ::= node-2
call ::= "<tool_call>" ws node-1 ws "</tool_call>"
unrestricted ::= .*
strict ::= ws ("NO_CALL" | call (ws call)*) ws
