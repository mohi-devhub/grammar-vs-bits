node-14-s-0 ::= "\"player_name\"" ws ":" ws node-15 node-14-s-1 | "\"team_name\"" ws ":" ws node-16 node-14-s-2 | "\"competition\"" ws ":" ws node-17 node-14-s-4
node-14-s-1 ::= ws "," ws "\"team_name\"" ws ":" ws node-16 node-14-s-3 | ws "," ws "\"competition\"" ws ":" ws node-17 node-14-s-5
node-14-s-2 ::= ws "," ws "\"player_name\"" ws ":" ws node-15 node-14-s-3 | ws "," ws "\"competition\"" ws ":" ws node-17 node-14-s-6
node-14-s-3 ::= "" | ws "," ws "\"competition\"" ws ":" ws node-17 node-14-s-7
