root ::= ws ("NO_CALL" | call (ws call)*) ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "true" | "false"
null ::= "null"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= "\"detailed_weather_forecast\""
node-5 ::= string
node-6 ::= integer
node-7 ::= boolean
node-4-s-0 ::= "\"location\"" ws ":" ws node-5 node-4-s-1 | "\"duration\"" ws ":" ws node-6 node-4-s-2 | "\"include_precipitation\"" ws ":" ws node-7 node-4-s-4
node-4-s-1 ::= ws "," ws "\"duration\"" ws ":" ws node-6 node-4-s-3 | ws "," ws "\"include_precipitation\"" ws ":" ws node-7 node-4-s-5
node-4-s-2 ::= ws "," ws "\"location\"" ws ":" ws node-5 node-4-s-3 | ws "," ws "\"include_precipitation\"" ws ":" ws node-7 node-4-s-6
node-4-s-3 ::= "" | ws "," ws "\"include_precipitation\"" ws ":" ws node-7 node-4-s-7
node-4-s-4 ::= ws "," ws "\"location\"" ws ":" ws node-5 node-4-s-5 | ws "," ws "\"duration\"" ws ":" ws node-6 node-4-s-6
node-4-s-5 ::= ws "," ws "\"duration\"" ws ":" ws node-6 node-4-s-7
node-4-s-6 ::= ws "," ws "\"location\"" ws ":" ws node-5 node-4-s-7
node-4-s-7 ::= ""
node-4 ::= "{" ws node-4-s-0 ws "}"
node-2-s-0 ::= "\"name\"" ws ":" ws node-3 node-2-s-1 | "\"arguments\"" ws ":" ws node-4 node-2-s-2
node-2-s-1 ::= ws "," ws "\"arguments\"" ws ":" ws node-4 node-2-s-3
node-2-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-3 node-2-s-3
node-2-s-3 ::= ""
node-2 ::= "{" ws node-2-s-0 ws "}"
node-9 ::= "\"recipe_search\""
node-11 ::= string
node-13 ::= string
node-12 ::= "[" ws (node-13 (ws "," ws node-13)*)? ws "]"
node-14 ::= integer
node-10-s-0 ::= "\"dietary_restriction\"" ws ":" ws node-11 node-10-s-1 | "\"ingredients\"" ws ":" ws node-12 node-10-s-2 | "\"servings\"" ws ":" ws node-14 node-10-s-4
node-10-s-1 ::= ws "," ws "\"ingredients\"" ws ":" ws node-12 node-10-s-3 | ws "," ws "\"servings\"" ws ":" ws node-14 node-10-s-5
node-10-s-2 ::= ws "," ws "\"dietary_restriction\"" ws ":" ws node-11 node-10-s-3 | ws "," ws "\"servings\"" ws ":" ws node-14 node-10-s-6
node-10-s-3 ::= ws "," ws "\"servings\"" ws ":" ws node-14 node-10-s-7
node-10-s-4 ::= ws "," ws "\"dietary_restriction\"" ws ":" ws node-11 node-10-s-5 | ws "," ws "\"ingredients\"" ws ":" ws node-12 node-10-s-6
node-10-s-5 ::= ws "," ws "\"ingredients\"" ws ":" ws node-12 node-10-s-7
node-10-s-6 ::= ws "," ws "\"dietary_restriction\"" ws ":" ws node-11 node-10-s-7
