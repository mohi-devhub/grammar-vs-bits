root ::= call (ws call)* ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "true" | "false"
null ::= "null"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= "\"safeway.vegan_products\""
node-5 ::= string
node-7 ::= "\"vegan\"" | "\"gluten-free\""
node-6 ::= "[" ws (node-7 (ws "," ws node-7)*)? ws "]"
node-4-s-0 ::= "\"location\"" ws ":" ws node-5 node-4-s-1 | "\"categories\"" ws ":" ws node-6 node-4-s-2
node-4-s-1 ::= "" | ws "," ws "\"categories\"" ws ":" ws node-6 node-4-s-3
node-4-s-2 ::= ws "," ws "\"location\"" ws ":" ws node-5 node-4-s-3
node-4-s-3 ::= ""
node-4 ::= "{" ws node-4-s-0 ws "}"
node-2-s-0 ::= "\"name\"" ws ":" ws node-3 node-2-s-1 | "\"arguments\"" ws ":" ws node-4 node-2-s-2
node-2-s-1 ::= ws "," ws "\"arguments\"" ws ":" ws node-4 node-2-s-3
node-2-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-3 node-2-s-3
node-2-s-3 ::= ""
node-2 ::= "{" ws node-2-s-0 ws "}"
node-9 ::= "\"wholefoods.vegan_products\""
node-11 ::= string
node-13 ::= "\"vegan\"" | "\"gluten-free\""
node-12 ::= "[" ws (node-13 (ws "," ws node-13)*)? ws "]"
node-10-s-0 ::= "\"location\"" ws ":" ws node-11 node-10-s-1 | "\"categories\"" ws ":" ws node-12 node-10-s-2
node-10-s-1 ::= "" | ws "," ws "\"categories\"" ws ":" ws node-12 node-10-s-3
node-10-s-2 ::= ws "," ws "\"location\"" ws ":" ws node-11 node-10-s-3
node-10-s-3 ::= ""
node-10 ::= "{" ws node-10-s-0 ws "}"
node-8-s-0 ::= "\"name\"" ws ":" ws node-9 node-8-s-1 | "\"arguments\"" ws ":" ws node-10 node-8-s-2
node-8-s-1 ::= ws "," ws "\"arguments\"" ws ":" ws node-10 node-8-s-3
node-8-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-9 node-8-s-3
node-8-s-3 ::= ""
node-8 ::= "{" ws node-8-s-0 ws "}"
node-15 ::= "\"walmart.vegan_products\""
node-17 ::= string
node-19 ::= "\"vegan\"" | "\"gluten-free\""
node-18 ::= "[" ws (node-19 (ws "," ws node-19)*)? ws "]"
node-16-s-0 ::= "\"location\"" ws ":" ws node-17 node-16-s-1 | "\"categories\"" ws ":" ws node-18 node-16-s-2
node-16-s-1 ::= "" | ws "," ws "\"categories\"" ws ":" ws node-18 node-16-s-3
node-16-s-2 ::= ws "," ws "\"location\"" ws ":" ws node-17 node-16-s-3
node-16-s-3 ::= ""
node-16 ::= "{" ws node-16-s-0 ws "}"
node-14-s-0 ::= "\"name\"" ws ":" ws node-15 node-14-s-1 | "\"arguments\"" ws ":" ws node-16 node-14-s-2
node-14-s-1 ::= ws "," ws "\"arguments\"" ws ":" ws node-16 node-14-s-3
node-14-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-15 node-14-s-3
node-14-s-3 ::= ""
node-14 ::= "{" ws node-14-s-0 ws "}"
node-1 ::= node-2 | node-8 | node-14
call ::= "<tool_call>" ws node-1 ws "</tool_call>"
