root ::= call (ws call)* ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "true" | "false"
null ::= "null"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= "\"walmart.purchase\""
node-5 ::= string
node-7 ::= string
node-6 ::= "[" ws (node-7 (ws "," ws node-7)*)? ws "]"
node-9 ::= integer
node-8 ::= "[" ws (node-9 (ws "," ws node-9)*)? ws "]"
node-4-s-0 ::= "\"loc\"" ws ":" ws node-5 node-4-s-1 | "\"product_list\"" ws ":" ws node-6 node-4-s-2 | "\"pack_size\"" ws ":" ws node-8 node-4-s-4
node-4-s-1 ::= ws "," ws "\"product_list\"" ws ":" ws node-6 node-4-s-3 | ws "," ws "\"pack_size\"" ws ":" ws node-8 node-4-s-5
node-4-s-2 ::= ws "," ws "\"loc\"" ws ":" ws node-5 node-4-s-3 | ws "," ws "\"pack_size\"" ws ":" ws node-8 node-4-s-6
node-4-s-3 ::= "" | ws "," ws "\"pack_size\"" ws ":" ws node-8 node-4-s-7
node-4-s-4 ::= ws "," ws "\"loc\"" ws ":" ws node-5 node-4-s-5 | ws "," ws "\"product_list\"" ws ":" ws node-6 node-4-s-6
node-4-s-5 ::= ws "," ws "\"product_list\"" ws ":" ws node-6 node-4-s-7
node-4-s-6 ::= ws "," ws "\"loc\"" ws ":" ws node-5 node-4-s-7
node-4-s-7 ::= ""
node-4 ::= "{" ws node-4-s-0 ws "}"
node-2-s-0 ::= "\"name\"" ws ":" ws node-3 node-2-s-1 | "\"arguments\"" ws ":" ws node-4 node-2-s-2
node-2-s-1 ::= ws "," ws "\"arguments\"" ws ":" ws node-4 node-2-s-3
node-2-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-3 node-2-s-3
node-2-s-3 ::= ""
node-2 ::= "{" ws node-2-s-0 ws "}"
node-11 ::= "\"musical_scale\""
node-13 ::= string
node-14 ::= string
node-12-s-0 ::= "\"key\"" ws ":" ws node-13 node-12-s-1 | "\"scale_type\"" ws ":" ws node-14 node-12-s-2
node-12-s-1 ::= "" | ws "," ws "\"scale_type\"" ws ":" ws node-14 node-12-s-3
node-12-s-2 ::= ws "," ws "\"key\"" ws ":" ws node-13 node-12-s-3
node-12-s-3 ::= ""
node-12 ::= "{" ws node-12-s-0 ws "}"
node-10-s-0 ::= "\"name\"" ws ":" ws node-11 node-10-s-1 | "\"arguments\"" ws ":" ws node-12 node-10-s-2
node-10-s-1 ::= ws "," ws "\"arguments\"" ws ":" ws node-12 node-10-s-3
node-10-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-11 node-10-s-3
node-10-s-3 ::= ""
node-10 ::= "{" ws node-10-s-0 ws "}"
node-1 ::= node-2 | node-10
call ::= "<tool_call>" ws node-1 ws "</tool_call>"
