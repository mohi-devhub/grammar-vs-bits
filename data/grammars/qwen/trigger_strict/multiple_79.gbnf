root ::= call (ws call)* ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "true" | "false"
null ::= "null"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= "\"restaurant_info\""
node-5 ::= string
node-6 ::= "\"Italian\"" | "\"Chinese\"" | "\"Mexican\"" | "\"American\""
node-4-s-0 ::= "\"location\"" ws ":" ws node-5 node-4-s-1 | "\"food_type\"" ws ":" ws node-6 node-4-s-2
node-4-s-1 ::= "" | ws "," ws "\"food_type\"" ws ":" ws node-6 node-4-s-3
node-4-s-2 ::= ws "," ws "\"location\"" ws ":" ws node-5 node-4-s-3
node-4-s-3 ::= ""
node-4 ::= "{" ws node-4-s-0 ws "}"
node-2-s-0 ::= "\"name\"" ws ":" ws node-3 node-2-s-1 | "\"arguments\"" ws ":" ws node-4 node-2-s-2
node-2-s-1 ::= ws "," ws "\"arguments\"" ws ":" ws node-4 node-2-s-3
node-2-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-3 node-2-s-3
node-2-s-3 ::= ""
node-2 ::= "{" ws node-2-s-0 ws "}"
node-8 ::= "\"exhibition_info\""
node-10 ::= string
node-11 ::= integer
node-9-s-0 ::= "\"museum_name\"" ws ":" ws node-10 node-9-s-1 | "\"month\"" ws ":" ws node-11 node-9-s-2
node-9-s-1 ::= "" | ws "," ws "\"month\"" ws ":" ws node-11 node-9-s-3
node-9-s-2 ::= ws "," ws "\"museum_name\"" ws ":" ws node-10 node-9-s-3
node-9-s-3 ::= ""
node-9 ::= "{" ws node-9-s-0 ws "}"
node-7-s-0 ::= "\"name\"" ws ":" ws node-8 node-7-s-1 | "\"arguments\"" ws ":" ws node-9 node-7-s-2
node-7-s-1 ::= ws "," ws "\"arguments\"" ws ":" ws node-9 node-7-s-3
node-7-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-8 node-7-s-3
node-7-s-3 ::= ""
node-7 ::= "{" ws node-7-s-0 ws "}"
node-1 ::= node-2 | node-7
call ::= "<tool_call>" ws node-1 ws "</tool_call>"
