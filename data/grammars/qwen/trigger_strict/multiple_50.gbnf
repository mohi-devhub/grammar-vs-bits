root ::= call (ws call)* ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "true" | "false"
null ::= "null"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= "\"house_price_forecast\""
node-5 ::= string
node-6 ::= integer
node-8 ::= "\"SqFt\"" | "\"Bedrooms\"" | "\"Bathrooms\"" | "\"Location\""
node-7 ::= "[" ws (node-8 (ws "," ws node-8)*)? ws "]"
node-4-s-0 ::= "\"location\"" ws ":" ws node-5 node-4-s-1 | "\"months\"" ws ":" ws node-6 node-4-s-2 | "\"features\"" ws ":" ws node-7 node-4-s-4
node-4-s-1 ::= ws "," ws "\"months\"" ws ":" ws node-6 node-4-s-3 | ws "," ws "\"features\"" ws ":" ws node-7 node-4-s-5
node-4-s-2 ::= ws "," ws "\"location\"" ws ":" ws node-5 node-4-s-3 | ws "," ws "\"features\"" ws ":" ws node-7 node-4-s-6
node-4-s-3 ::= "" | ws "," ws "\"features\"" ws ":" ws node-7 node-4-s-7
node-4-s-4 ::= ws "," ws "\"location\"" ws ":" ws node-5 node-4-s-5 | ws "," ws "\"months\"" ws ":" ws node-6 node-4-s-6
node-4-s-5 ::= ws "," ws "\"months\"" ws ":" ws node-6 node-4-s-7
node-4-s-6 ::= ws "," ws "\"location\"" ws ":" ws node-5 node-4-s-7
node-4-s-7 ::= ""
node-4 ::= "{" ws node-4-s-0 ws "}"
node-2-s-0 ::= "\"name\"" ws ":" ws node-3 node-2-s-1 | "\"arguments\"" ws ":" ws node-4 node-2-s-2
node-2-s-1 ::= ws "," ws "\"arguments\"" ws ":" ws node-4 node-2-s-3
node-2-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-3 node-2-s-3
node-2-s-3 ::= ""
node-2 ::= "{" ws node-2-s-0 ws "}"
node-10 ::= "\"weather_forecast\""
node-12 ::= string
node-13 ::= integer
node-11-s-0 ::= "\"location\"" ws ":" ws node-12 node-11-s-1 | "\"days\"" ws ":" ws node-13 node-11-s-2
node-11-s-1 ::= ws "," ws "\"days\"" ws ":" ws node-13 node-11-s-3
node-11-s-2 ::= ws "," ws "\"location\"" ws ":" ws node-12 node-11-s-3
node-11-s-3 ::= ""
node-11 ::= "{" ws node-11-s-0 ws "}"
node-9-s-0 ::= "\"name\"" ws ":" ws node-10 node-9-s-1 | "\"arguments\"" ws ":" ws node-11 node-9-s-2
node-9-s-1 ::= ws "," ws "\"arguments\"" ws ":" ws node-11 node-9-s-3
node-9-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-10 node-9-s-3
node-9-s-3 ::= ""
node-9 ::= "{" ws node-9-s-0 ws "}"
node-15 ::= "\"stock_market_forecast\""
node-17 ::= string
node-18 ::= integer
node-16-s-0 ::= "\"company\"" ws ":" ws node-17 node-16-s-1 | "\"days\"" ws ":" ws node-18 node-16-s-2
node-16-s-1 ::= ws "," ws "\"days\"" ws ":" ws node-18 node-16-s-3
node-16-s-2 ::= ws "," ws "\"company\"" ws ":" ws node-17 node-16-s-3
node-16-s-3 ::= ""
node-16 ::= "{" ws node-16-s-0 ws "}"
node-14-s-0 ::= "\"name\"" ws ":" ws node-15 node-14-s-1 | "\"arguments\"" ws ":" ws node-16 node-14-s-2
node-14-s-1 ::= ws "," ws "\"arguments\"" ws ":" ws node-16 node-14-s-3
node-14-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-15 node-14-s-3
node-14-s-3 ::= ""
node-14 ::= "{" ws node-14-s-0 ws "}"
node-1 ::= node-2 | node-9 | node-14
call ::= "<tool_call>" ws node-1 ws "</tool_call>"
