root ::= call (ws call)* ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "true" | "false"
null ::= "null"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= "\"maps.route_times\""
node-5 ::= string
node-6 ::= string
node-4-s-0 ::= "\"route\"" ws ":" ws node-5 node-4-s-1 | "\"mode\"" ws ":" ws node-6 node-4-s-2
node-4-s-1 ::= "" | ws "," ws "\"mode\"" ws ":" ws node-6 node-4-s-3
node-4-s-2 ::= ws "," ws "\"route\"" ws ":" ws node-5 node-4-s-3
node-4-s-3 ::= ""
node-4 ::= "{" ws node-4-s-0 ws "}"
node-2-s-0 ::= "\"name\"" ws ":" ws node-3 node-2-s-1 | "\"arguments\"" ws ":" ws node-4 node-2-s-2
node-2-s-1 ::= ws "," ws "\"arguments\"" ws ":" ws node-4 node-2-s-3
node-2-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-3 node-2-s-3
node-2-s-3 ::= ""
node-2 ::= "{" ws node-2-s-0 ws "}"
node-8 ::= "\"maps.shortest_path\""
node-10 ::= string
node-11 ::= string
node-12 ::= string
node-9-s-0 ::= "\"start_location\"" ws ":" ws node-10 node-9-s-1 | "\"end_location\"" ws ":" ws node-11 node-9-s-2 | "\"mode\"" ws ":" ws node-12 node-9-s-4
node-9-s-1 ::= ws "," ws "\"end_location\"" ws ":" ws node-11 node-9-s-3 | ws "," ws "\"mode\"" ws ":" ws node-12 node-9-s-5
node-9-s-2 ::= ws "," ws "\"start_location\"" ws ":" ws node-10 node-9-s-3 | ws "," ws "\"mode\"" ws ":" ws node-12 node-9-s-6
node-9-s-3 ::= "" | ws "," ws "\"mode\"" ws ":" ws node-12 node-9-s-7
node-9-s-4 ::= ws "," ws "\"start_location\"" ws ":" ws node-10 node-9-s-5 | ws "," ws "\"end_location\"" ws ":" ws node-11 node-9-s-6
node-9-s-5 ::= ws "," ws "\"end_location\"" ws ":" ws node-11 node-9-s-7
node-9-s-6 ::= ws "," ws "\"start_location\"" ws ":" ws node-10 node-9-s-7
node-9-s-7 ::= ""
node-9 ::= "{" ws node-9-s-0 ws "}"
node-7-s-0 ::= "\"name\"" ws ":" ws node-8 node-7-s-1 | "\"arguments\"" ws ":" ws node-9 node-7-s-2
node-7-s-1 ::= ws "," ws "\"arguments\"" ws ":" ws node-9 node-7-s-3
node-7-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-8 node-7-s-3
node-7-s-3 ::= ""
node-7 ::= "{" ws node-7-s-0 ws "}"
node-1 ::= node-2 | node-7
call ::= "<tool_call>" ws node-1 ws "</tool_call>"
