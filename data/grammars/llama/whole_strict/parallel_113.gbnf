root ::= ws ("NO_CALL" | call | "[" ws call (ws "," ws call)* ws "]") ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "true" | "false"
null ::= "null"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= "\"diabetes_prediction\""
node-5 ::= integer
node-6 ::= integer
node-7 ::= "\"sedentary\"" | "\"lightly active\"" | "\"moderately active\"" | "\"very active\"" | "\"extra active\""
node-4-s-0 ::= "\"weight\"" ws ":" ws node-5 node-4-s-1 | "\"height\"" ws ":" ws node-6 node-4-s-2 | "\"activity_level\"" ws ":" ws node-7 node-4-s-4
node-4-s-1 ::= ws "," ws "\"height\"" ws ":" ws node-6 node-4-s-3 | ws "," ws "\"activity_level\"" ws ":" ws node-7 node-4-s-5
node-4-s-2 ::= ws "," ws "\"weight\"" ws ":" ws node-5 node-4-s-3 | ws "," ws "\"activity_level\"" ws ":" ws node-7 node-4-s-6
node-4-s-3 ::= ws "," ws "\"activity_level\"" ws ":" ws node-7 node-4-s-7
node-4-s-4 ::= ws "," ws "\"weight\"" ws ":" ws node-5 node-4-s-5 | ws "," ws "\"height\"" ws ":" ws node-6 node-4-s-6
node-4-s-5 ::= ws "," ws "\"height\"" ws ":" ws node-6 node-4-s-7
node-4-s-6 ::= ws "," ws "\"weight\"" ws ":" ws node-5 node-4-s-7
node-4-s-7 ::= ""
node-4 ::= "{" ws node-4-s-0 ws "}"
node-2-s-0 ::= "\"name\"" ws ":" ws node-3 node-2-s-1 | "\"parameters\"" ws ":" ws node-4 node-2-s-2
node-2-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-4 node-2-s-3
node-2-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-3 node-2-s-3
node-2-s-3 ::= ""
node-2 ::= "{" ws node-2-s-0 ws "}"
node-1 ::= node-2
call ::= node-1
