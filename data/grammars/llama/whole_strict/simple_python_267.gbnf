root ::= ws ("NO_CALL" | call | "[" ws call (ws "," ws call)* ws "]") ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "true" | "false"
null ::= "null"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= "\"find_exhibition\""
node-5 ::= string
node-6 ::= string
node-7 ::= string
node-8 ::= "\"low\"" | "\"average\"" | "\"high\""
node-4-s-0 ::= "\"location\"" ws ":" ws node-5 node-4-s-1 | "\"art_form\"" ws ":" ws node-6 node-4-s-2 | "\"month\"" ws ":" ws node-7 node-4-s-4 | "\"user_ratings\"" ws ":" ws node-8 node-4-s-8
node-4-s-1 ::= ws "," ws "\"art_form\"" ws ":" ws node-6 node-4-s-3 | ws "," ws "\"month\"" ws ":" ws node-7 node-4-s-5 | ws "," ws "\"user_ratings\"" ws ":" ws node-8 node-4-s-9
node-4-s-2 ::= ws "," ws "\"location\"" ws ":" ws node-5 node-4-s-3 | ws "," ws "\"month\"" ws ":" ws node-7 node-4-s-6 | ws "," ws "\"user_ratings\"" ws ":" ws node-8 node-4-s-10
node-4-s-3 ::= "" | ws "," ws "\"month\"" ws ":" ws node-7 node-4-s-7 | ws "," ws "\"user_ratings\"" ws ":" ws node-8 node-4-s-11
node-4-s-4 ::= ws "," ws "\"location\"" ws ":" ws node-5 node-4-s-5 | ws "," ws "\"art_form\"" ws ":" ws node-6 node-4-s-6 | ws "," ws "\"user_ratings\"" ws ":" ws node-8 node-4-s-12
node-4-s-5 ::= ws "," ws "\"art_form\"" ws ":" ws node-6 node-4-s-7 | ws "," ws "\"user_ratings\"" ws ":" ws node-8 node-4-s-13
node-4-s-6 ::= ws "," ws "\"location\"" ws ":" ws node-5 node-4-s-7 | ws "," ws "\"user_ratings\"" ws ":" ws node-8 node-4-s-14
node-4-s-7 ::= "" | ws "," ws "\"user_ratings\"" ws ":" ws node-8 node-4-s-15
node-4-s-8 ::= ws "," ws "\"location\"" ws ":" ws node-5 node-4-s-9 | ws "," ws "\"art_form\"" ws ":" ws node-6 node-4-s-10 | ws "," ws "\"month\"" ws ":" ws node-7 node-4-s-12
node-4-s-9 ::= ws "," ws "\"art_form\"" ws ":" ws node-6 node-4-s-11 | ws "," ws "\"month\"" ws ":" ws node-7 node-4-s-13
node-4-s-10 ::= ws "," ws "\"location\"" ws ":" ws node-5 node-4-s-11 | ws "," ws "\"month\"" ws ":" ws node-7 node-4-s-14
node-4-s-11 ::= "" | ws "," ws "\"month\"" ws ":" ws node-7 node-4-s-15
node-4-s-12 ::= ws "," ws "\"location\"" ws ":" ws node-5 node-4-s-13 | ws "," ws "\"art_form\"" ws ":" ws node-6 node-4-s-14
node-4-s-13 ::= ws "," ws "\"art_form\"" ws ":" ws node-6 node-4-s-15
node-4-s-14 ::= ws "," ws "\"location\"" ws ":" ws node-5 node-4-s-15
node-4-s-15 ::= ""
node-4 ::= "{" ws node-4-s-0 ws "}"
node-2-s-0 ::= "\"name\"" ws ":" ws node-3 node-2-s-1 | "\"parameters\"" ws ":" ws node-4 node-2-s-2
node-2-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-4 node-2-s-3
node-2-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-3 node-2-s-3
node-2-s-3 ::= ""
node-2 ::= "{" ws node-2-s-0 ws "}"
node-1 ::= node-2
call ::= node-1
