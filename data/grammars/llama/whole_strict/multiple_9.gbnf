root ::= ws ("NO_CALL" | call | "[" ws call (ws "," ws call)* ws "]") ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "true" | "false"
null ::= "null"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= "\"calculate_standard_deviation\""
node-5 ::= any-object
node-4-s-0 ::= "\"gradeDict\"" ws ":" ws node-5 node-4-s-1
node-4-s-1 ::= ""
node-4 ::= "{" ws node-4-s-0 ws "}"
node-2-s-0 ::= "\"name\"" ws ":" ws node-3 node-2-s-1 | "\"parameters\"" ws ":" ws node-4 node-2-s-2
node-2-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-4 node-2-s-3
node-2-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-3 node-2-s-3
node-2-s-3 ::= ""
node-2 ::= "{" ws node-2-s-0 ws "}"
node-7 ::= "\"calculate_average\""
node-9 ::= any-object
node-8-s-0 ::= "\"gradeDict\"" ws ":" ws node-9 node-8-s-1
node-8-s-1 ::= ""
node-8 ::= "{" ws node-8-s-0 ws "}"
node-6-s-0 ::= "\"name\"" ws ":" ws node-7 node-6-s-1 | "\"parameters\"" ws ":" ws node-8 node-6-s-2
node-6-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-8 node-6-s-3
node-6-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-7 node-6-s-3
node-6-s-3 ::= ""
node-6 ::= "{" ws node-6-s-0 ws "}"
node-11 ::= "\"highest_grade\""
node-13 ::= any-object
node-12-s-0 ::= "\"gradeDict\"" ws ":" ws node-13 node-12-s-1
node-12-s-1 ::= ""
node-12 ::= "{" ws node-12-s-0 ws "}"
node-10-s-0 ::= "\"name\"" ws ":" ws node-11 node-10-s-1 | "\"parameters\"" ws ":" ws node-12 node-10-s-2
node-10-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-12 node-10-s-3
node-10-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-11 node-10-s-3
node-10-s-3 ::= ""
node-10 ::= "{" ws node-10-s-0 ws "}"
node-1 ::= node-2 | node-6 | node-10
call ::= node-1
