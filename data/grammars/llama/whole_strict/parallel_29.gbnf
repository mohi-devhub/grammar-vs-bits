root ::= ws ("NO_CALL" | call | "[" ws call (ws "," ws call)* ws "]") ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "true" | "false"
null ::= "null"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= "\"waste_calculation.calculate\""
node-6 ::= value
node-7 ::= value
node-8 ::= value
node-5-s-0 ::= "\"adults\"" ws ":" ws node-6 node-5-s-1 | "\"children\"" ws ":" ws node-7 node-5-s-2 | "\"singles\"" ws ":" ws node-8 node-5-s-4
node-5-s-1 ::= ws "," ws "\"children\"" ws ":" ws node-7 node-5-s-3 | ws "," ws "\"singles\"" ws ":" ws node-8 node-5-s-5
node-5-s-2 ::= ws "," ws "\"adults\"" ws ":" ws node-6 node-5-s-3 | ws "," ws "\"singles\"" ws ":" ws node-8 node-5-s-6
node-5-s-3 ::= ws "," ws "\"singles\"" ws ":" ws node-8 node-5-s-7
node-5-s-4 ::= ws "," ws "\"adults\"" ws ":" ws node-6 node-5-s-5 | ws "," ws "\"children\"" ws ":" ws node-7 node-5-s-6
node-5-s-5 ::= ws "," ws "\"children\"" ws ":" ws node-7 node-5-s-7
node-5-s-6 ::= ws "," ws "\"adults\"" ws ":" ws node-6 node-5-s-7
node-5-s-7 ::= ""
node-5 ::= "{" ws node-5-s-0 ws "}"
node-9 ::= string
node-4-s-0 ::= "\"population\"" ws ":" ws node-5 node-4-s-1 | "\"location\"" ws ":" ws node-9 node-4-s-2
node-4-s-1 ::= ws "," ws "\"location\"" ws ":" ws node-9 node-4-s-3
node-4-s-2 ::= ws "," ws "\"population\"" ws ":" ws node-5 node-4-s-3
node-4-s-3 ::= ""
node-4 ::= "{" ws node-4-s-0 ws "}"
node-2-s-0 ::= "\"name\"" ws ":" ws node-3 node-2-s-1 | "\"parameters\"" ws ":" ws node-4 node-2-s-2
node-2-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-4 node-2-s-3
node-2-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-3 node-2-s-3
node-2-s-3 ::= ""
node-2 ::= "{" ws node-2-s-0 ws "}"
node-1 ::= node-2
call ::= node-1
