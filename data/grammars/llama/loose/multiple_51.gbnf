root ::= strict | unrestricted
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "true" | "false"
null ::= "null"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= "\"dice_roll_probability\""
node-5 ::= integer
node-6 ::= integer
node-7 ::= integer
node-4-s-0 ::= "\"desired_sum\"" ws ":" ws node-5 node-4-s-1 | "\"n_rolls\"" ws ":" ws node-6 node-4-s-2 | "\"sides_per_die\"" ws ":" ws node-7 node-4-s-4
node-4-s-1 ::= ws "," ws "\"n_rolls\"" ws ":" ws node-6 node-4-s-3 | ws "," ws "\"sides_per_die\"" ws ":" ws node-7 node-4-s-5
node-4-s-2 ::= ws "," ws "\"desired_sum\"" ws ":" ws node-5 node-4-s-3 | ws "," ws "\"sides_per_die\"" ws ":" ws node-7 node-4-s-6
node-4-s-3 ::= ws "," ws "\"sides_per_die\"" ws ":" ws node-7 node-4-s-7
node-4-s-4 ::= ws "," ws "\"desired_sum\"" ws ":" ws node-5 node-4-s-5 | ws "," ws "\"n_rolls\"" ws ":" ws node-6 node-4-s-6
node-4-s-5 ::= "" | ws "," ws "\"n_rolls\"" ws ":" ws node-6 node-4-s-7
node-4-s-6 ::= ws "," ws "\"desired_sum\"" ws ":" ws node-5 node-4-s-7
node-4-s-7 ::= ""
node-4 ::= "{" ws node-4-s-0 ws "}"
node-2-s-0 ::= "\"name\"" ws ":" ws node-3 node-2-s-1 | "\"parameters\"" ws ":" ws node-4 node-2-s-2
node-2-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-4 node-2-s-3
node-2-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-3 node-2-s-3
node-2-s-3 ::= ""
node-2 ::= "{" ws node-2-s-0 ws "}"
node-9 ::= "\"flip_coin_probability\""
node-11 ::= string
node-12 ::= integer
node-10-s-0 ::= "\"desired_outcome\"" ws ":" ws node-11 node-10-s-1 | "\"n_flips\"" ws ":" ws node-12 node-10-s-2
node-10-s-1 ::= "" | ws "," ws "\"n_flips\"" ws ":" ws node-12 node-10-s-3
node-10-s-2 ::= ws "," ws "\"desired_outcome\"" ws ":" ws node-11 node-10-s-3
node-10-s-3 ::= ""
node-10 ::= "{" ws node-10-s-0 ws "}"
node-8-s-0 ::= "\"name\"" ws ":" ws node-9 node-8-s-1 | "\"parameters\"" ws ":" ws node-10 node-8-s-2
node-8-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-10 node-8-s-3
node-8-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-9 node-8-s-3
node-8-s-3 ::= ""
node-8 ::= "{" ws node-8-s-0 ws "}"
node-14 ::= "\"shuffle_card_probability\""
node-16 ::= string
node-17 ::= integer
node-15-s-0 ::= "\"desired_card\"" ws ":" ws node-16 node-15-s-1 | "\"n_decks\"" ws ":" ws node-17 node-15-s-2
node-15-s-1 ::= "" | ws "," ws "\"n_decks\"" ws ":" ws node-17 node-15-s-3
node-15-s-2 ::= ws "," ws "\"desired_card\"" ws ":" ws node-16 node-15-s-3
node-15-s-3 ::= ""
node-15 ::= "{" ws node-15-s-0 ws "}"
node-13-s-0 ::= "\"name\"" ws ":" ws node-14 node-13-s-1 | "\"parameters\"" ws ":" ws node-15 node-13-s-2
node-13-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-15 node-13-s-3
node-13-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-14 node-13-s-3
node-13-s-3 ::= ""
node-13 ::= "{" ws node-13-s-0 ws "}"
node-1 ::= node-2 | node-8 | node-13
call ::= node-1
unrestricted ::= .*
strict ::= ws ("NO_CALL" | call | "[" ws call (ws "," ws call)* ws "]") ws
