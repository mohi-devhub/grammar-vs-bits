root ::= strict | unrestricted
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "true" | "false"
null ::= "null"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= "\"math.triangle_area_heron\""
node-5 ::= integer
node-6 ::= integer
node-7 ::= integer
node-4-s-0 ::= "\"side1\"" ws ":" ws node-5 node-4-s-1 | "\"side2\"" ws ":" ws node-6 node-4-s-2 | "\"side3\"" ws ":" ws node-7 node-4-s-4
node-4-s-1 ::= ws "," ws "\"side2\"" ws ":" ws node-6 node-4-s-3 | ws "," ws "\"side3\"" ws ":" ws node-7 node-4-s-5
node-4-s-2 ::= ws "," ws "\"side1\"" ws ":" ws node-5 node-4-s-3 | ws "," ws "\"side3\"" ws ":" ws node-7 node-4-s-6
node-4-s-3 ::= ws "," ws "\"side3\"" ws ":" ws node-7 node-4-s-7
node-4-s-4 ::= ws "," ws "\"side1\"" ws ":" ws node-5 node-4-s-5 | ws "," ws "\"side2\"" ws ":" ws node-6 node-4-s-6
node-4-s-5 ::= ws "," ws "\"side2\"" ws ":" ws node-6 node-4-s-7
node-4-s-6 ::= ws "," ws "\"side1\"" ws ":" ws node-5 node-4-s-7
node-4-s-7 ::= ""
node-4 ::= "{" ws node-4-s-0 ws "}"
node-2-s-0 ::= "\"name\"" ws ":" ws node-3 node-2-s-1 | "\"parameters\"" ws ":" ws node-4 node-2-s-2
node-2-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-4 node-2-s-3
node-2-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-3 node-2-s-3
node-2-s-3 ::= ""
node-2 ::= "{" ws node-2-s-0 ws "}"
node-9 ::= "\"math.circle_area\""
node-11 ::= number
node-10-s-0 ::= "\"radius\"" ws ":" ws node-11 node-10-s-1
node-10-s-1 ::= ""
node-10 ::= "{" ws node-10-s-0 ws "}"
node-8-s-0 ::= "\"name\"" ws ":" ws node-9 node-8-s-1 | "\"parameters\"" ws ":" ws node-10 node-8-s-2
node-8-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-10 node-8-s-3
node-8-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-9 node-8-s-3
node-8-s-3 ::= ""
node-8 ::= "{" ws node-8-s-0 ws "}"
node-13 ::= "\"math.triangle_area_base_height\""
node-15 ::= number
node-16 ::= number
node-14-s-0 ::= "\"base\"" ws ":" ws node-15 node-14-s-1 | "\"height\"" ws ":" ws node-16 node-14-s-2
node-14-s-1 ::= ws "," ws "\"height\"" ws ":" ws node-16 node-14-s-3
node-14-s-2 ::= ws "," ws "\"base\"" ws ":" ws node-15 node-14-s-3
node-14-s-3 ::= ""
node-14 ::= "{" ws node-14-s-0 ws "}"
node-12-s-0 ::= "\"name\"" ws ":" ws node-13 node-12-s-1 | "\"parameters\"" ws ":" ws node-14 node-12-s-2
node-12-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-14 node-12-s-3
node-12-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-13 node-12-s-3
node-12-s-3 ::= ""
node-12 ::= "{" ws node-12-s-0 ws "}"
node-1 ::= node-2 | node-8 | node-12
call ::= node-1
unrestricted ::= .*
strict ::= ws ("NO_CALL" | call | "[" ws call (ws "," ws call)* ws "]") ws
