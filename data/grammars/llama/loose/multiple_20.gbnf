root ::= strict | unrestricted
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "true" | "false"
null ::= "null"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= "\"sculptor_info.get\""
node-5 ::= string
node-4-s-0 ::= "\"name\"" ws ":" ws node-5 node-4-s-1
node-4-s-1 ::= ""
node-4 ::= "{" ws node-4-s-0 ws "}"
node-2-s-0 ::= "\"name\"" ws ":" ws node-3 node-2-s-1 | "\"parameters\"" ws ":" ws node-4 node-2-s-2
node-2-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-4 node-2-s-3
node-2-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-3 node-2-s-3
node-2-s-3 ::= ""
node-2 ::= "{" ws node-2-s-0 ws "}"
node-7 ::= "\"sculpture_price.calculate\""
node-9 ::= string
node-10 ::= integer
node-11 ::= "\"low\"" | "\"medium\"" | "\"high\""
node-8-s-0 ::= "\"material\"" ws ":" ws node-9 node-8-s-1 | "\"size\"" ws ":" ws node-10 node-8-s-2 | "\"complexity\"" ws ":" ws node-11 node-8-s-4
node-8-s-1 ::= ws "," ws "\"size\"" ws ":" ws node-10 node-8-s-3 | ws "," ws "\"complexity\"" ws ":" ws node-11 node-8-s-5
node-8-s-2 ::= ws "," ws "\"material\"" ws ":" ws node-9 node-8-s-3 | ws "," ws "\"complexity\"" ws ":" ws node-11 node-8-s-6
node-8-s-3 ::= "" | ws "," ws "\"complexity\"" ws ":" ws node-11 node-8-s-7
node-8-s-4 ::= ws "," ws "\"material\"" ws ":" ws node-9 node-8-s-5 | ws "," ws "\"size\"" ws ":" ws node-10 node-8-s-6
node-8-s-5 ::= ws "," ws "\"size\"" ws ":" ws node-10 node-8-s-7
node-8-s-6 ::= ws "," ws "\"material\"" ws ":" ws node-9 node-8-s-7
node-8-s-7 ::= ""
node-8 ::= "{" ws node-8-s-0 ws "}"
node-6-s-0 ::= "\"name\"" ws ":" ws node-7 node-6-s-1 | "\"parameters\"" ws ":" ws node-8 node-6-s-2
node-6-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-8 node-6-s-3
node-6-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-7 node-6-s-3
node-6-s-3 ::= ""
node-6 ::= "{" ws node-6-s-0 ws "}"
node-13 ::= "\"sculpture_availability.check\""
node-15 ::= string
node-16 ::= string
node-14-s-0 ::= "\"sculpture_name\"" ws ":" ws node-15 node-14-s-1 | "\"material\"" ws ":" ws node-16 node-14-s-2
node-14-s-1 ::= ws "," ws "\"material\"" ws ":" ws node-16 node-14-s-3
node-14-s-2 ::= ws "," ws "\"sculpture_name\"" ws ":" ws node-15 node-14-s-3
node-14-s-3 ::= ""
node-14 ::= "{" ws node-14-s-0 ws "}"
node-12-s-0 ::= "\"name\"" ws ":" ws node-13 node-12-s-1 | "\"parameters\"" ws ":" ws node-14 node-12-s-2
node-12-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-14 node-12-s-3
node-12-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-13 node-12-s-3
node-12-s-3 ::= ""
node-12 ::= "{" ws node-12-s-0 ws "}"
node-1 ::= node-2 | node-6 | node-12
call ::= node-1
unrestricted ::= .*
strict ::= ws ("NO_CALL" | call | "[" ws call (ws "," ws call)* ws "]") ws
