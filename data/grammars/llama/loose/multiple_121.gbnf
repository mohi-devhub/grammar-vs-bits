node-11-s-1 ::= ws "," ws "\"want_year\"" ws ":" ws node-13 node-11-s-3
node-11-s-2 ::= ws "," ws "\"invention_name\"" ws ":" ws node-12 node-11-s-3
node-11-s-3 ::= ""
node-11 ::= "{" ws node-11-s-0 ws "}"
node-9-s-0 ::= "\"name\"" ws ":" ws node-10 node-9-s-1 | "\"parameters\"" ws ":" ws node-11 node-9-s-2
node-9-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-11 node-9-s-3
node-9-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-10 node-9-s-3
node-9-s-3 ::= ""
