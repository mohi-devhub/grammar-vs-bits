node-16-s-1 ::= ws "," ws "\"height\"" ws ":" ws node-18 node-16-s-3 | ws "," ws "\"unit\"" ws ":" ws node-19 node-16-s-5
node-16-s-2 ::= ws "," ws "\"base\"" ws ":" ws node-17 node-16-s-3 | ws "," ws "\"unit\"" ws ":" ws node-19 node-16-s-6
node-16-s-3 ::= "" | ws "," ws "\"unit\"" ws ":" ws node-19 node-16-s-7
node-16-s-4 ::= ws "," ws "\"base\"" ws ":" ws node-17 node-16-s-5 | ws "," ws "\"height\"" ws ":" ws node-18 node-16-s-6
node-16-s-5 ::= ws "," ws "\"height\"" ws ":" ws node-18 node-16-s-7
