root ::= strict | unrestricted
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "true" | "false"
null ::= "null"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= "\"map_service.get_directions\""
node-5 ::= string
node-6 ::= string
node-8 ::= "\"tolls\"" | "\"highways\"" | "\"ferries\""
node-7 ::= "[" ws (node-8 (ws "," ws node-8)*)? ws "]"
node-4-s-0 ::= "\"start\"" ws ":" ws node-5 node-4-s-1 | "\"end\"" ws ":" ws node-6 node-4-s-2 | "\"avoid\"" ws ":" ws node-7 node-4-s-4
node-4-s-1 ::= ws "," ws "\"end\"" ws ":" ws node-6 node-4-s-3 | ws "," ws "\"avoid\"" ws ":" ws node-7 node-4-s-5
node-4-s-2 ::= ws "," ws "\"start\"" ws ":" ws node-5 node-4-s-3 | ws "," ws "\"avoid\"" ws ":" ws node-7 node-4-s-6
node-4-s-3 ::= "" | ws "," ws "\"avoid\"" ws ":" ws node-7 node-4-s-7
