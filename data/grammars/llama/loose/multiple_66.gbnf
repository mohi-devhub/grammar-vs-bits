root ::= strict | unrestricted
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "true" | "false"
null ::= "null"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= "\"calculate_distance\""
node-5 ::= string
node-6 ::= string
node-4-s-0 ::= "\"start_point\"" ws ":" ws node-5 node-4-s-1 | "\"end_point\"" ws ":" ws node-6 node-4-s-2
node-4-s-1 ::= ws "," ws "\"end_point\"" ws ":" ws node-6 node-4-s-3
node-4-s-2 ::= ws "," ws "\"start_point\"" ws ":" ws node-5 node-4-s-3
node-4-s-3 ::= ""
node-4 ::= "{" ws node-4-s-0 ws "}"
node-2-s-0 ::= "\"name\"" ws ":" ws node-3 node-2-s-1 | "\"parameters\"" ws ":" ws node-4 node-2-s-2
node-2-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-4 node-2-s-3
node-2-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-3 node-2-s-3
node-2-s-3 ::= ""
node-2 ::= "{" ws node-2-s-0 ws "}"
node-8 ::= "\"traffic_estimate\""
node-10 ::= string
node-11 ::= string
node-12 ::= string
node-9-s-0 ::= "\"start_location\"" ws ":" ws node-10 node-9-s-1 | "\"end_location\"" ws ":" ws node-11 node-9-s-2 | "\"time_period\"" ws ":" ws node-12 node-9-s-4
node-9-s-1 ::= ws "," ws "\"end_location\"" ws ":" ws node-11 node-9-s-3 | ws "," ws "\"time_period\"" ws ":" ws node-12 node-9-s-5
node-9-s-2 ::= ws "," ws "\"start_location\"" ws ":" ws node-10 node-9-s-3 | ws "," ws "\"time_period\"" ws ":" ws node-12 node-9-s-6
node-9-s-3 ::= "" | ws "," ws "\"time_period\"" ws ":" ws node-12 node-9-s-7
node-9-s-4 ::= ws "," ws "\"start_location\"" ws ":" ws node-10 node-9-s-5 | ws "," ws "\"end_location\"" ws ":" ws node-11 node-9-s-6
node-9-s-5 ::= ws "," ws "\"end_location\"" ws ":" ws node-11 node-9-s-7
node-9-s-6 ::= ws "," ws "\"start_location\"" ws ":" ws node-10 node-9-s-7
node-9-s-7 ::= ""
node-9 ::= "{" ws node-9-s-0 ws "}"
node-7-s-0 ::= "\"name\"" ws ":" ws node-8 node-7-s-1 | "\"parameters\"" ws ":" ws node-9 node-7-s-2
node-7-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-9 node-7-s-3
node-7-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-8 node-7-s-3
node-7-s-3 ::= ""
node-7 ::= "{" ws node-7-s-0 ws "}"
node-14 ::= "\"weather_forecast\""
node-16 ::= string
node-17 ::= integer
node-15-s-0 ::= "\"location\"" ws ":" ws node-16 node-15-s-1 | "\"days\"" ws ":" ws node-17 node-15-s-2
node-15-s-1 ::= ws "," ws "\"days\"" ws ":" ws node-17 node-15-s-3
node-15-s-2 ::= ws "," ws "\"location\"" ws ":" ws node-16 node-15-s-3
node-15-s-3 ::= ""
node-15 ::= "{" ws node-15-s-0 ws "}"
node-13-s-0 ::= "\"name\"" ws ":" ws node-14 node-13-s-1 | "\"parameters\"" ws ":" ws node-15 node-13-s-2
node-13-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-15 node-13-s-3
node-13-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-14 node-13-s-3
node-13-s-3 ::= ""
node-13 ::= "{" ws node-13-s-0 ws "}"
node-1 ::= node-2 | node-7 | node-13
call ::= node-1
unrestricted ::= .*
strict ::= ws ("NO_CALL" | call | "[" ws call (ws "," ws call)* ws "]") ws
