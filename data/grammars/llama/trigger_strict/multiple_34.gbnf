root ::= ws ("NO_CALL" | call | "[" ws call (ws "," ws call)* ws "]") ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "true" | "false"
null ::= "null"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= "\"math.gcd\""
node-5 ::= integer
node-6 ::= integer
node-4-s-0 ::= "\"num1\"" ws ":" ws node-5 node-4-s-1 | "\"num2\"" ws ":" ws node-6 node-4-s-2
node-4-s-1 ::= ws "," ws "\"num2\"" ws ":" ws node-6 node-4-s-3
node-4-s-2 ::= ws "," ws "\"num1\"" ws ":" ws node-5 node-4-s-3
node-4-s-3 ::= ""
node-4 ::= "{" ws node-4-s-0 ws "}"
node-2-s-0 ::= "\"name\"" ws ":" ws node-3 node-2-s-1 | "\"parameters\"" ws ":" ws node-4 node-2-s-2
node-2-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-4 node-2-s-3
node-2-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-3 node-2-s-3
node-2-s-3 ::= ""
node-2 ::= "{" ws node-2-s-0 ws "}"
node-8 ::= "\"math.sqrt\""
node-10 ::= number
node-11 ::= integer
node-9-s-0 ::= "\"num\"" ws ":" ws node-10 node-9-s-1 | "\"accuracy\"" ws ":" ws node-11 node-9-s-2
node-9-s-1 ::= "" | ws "," ws "\"accuracy\"" ws ":" ws node-11 node-9-s-3
node-9-s-2 ::= ws "," ws "\"num\"" ws ":" ws node-10 node-9-s-3
node-9-s-3 ::= ""
node-9 ::= "{" ws node-9-s-0 ws "}"
node-7-s-0 ::= "\"name\"" ws ":" ws node-8 node-7-s-1 | "\"parameters\"" ws ":" ws node-9 node-7-s-2
node-7-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-9 node-7-s-3
node-7-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-8 node-7-s-3
node-7-s-3 ::= ""
node-7 ::= "{" ws node-7-s-0 ws "}"
node-13 ::= "\"math.lcm\""
node-15 ::= integer
node-16 ::= integer
node-14-s-0 ::= "\"num1\"" ws ":" ws node-15 node-14-s-1 | "\"num2\"" ws ":" ws node-16 node-14-s-2
node-14-s-1 ::= ws "," ws "\"num2\"" ws ":" ws node-16 node-14-s-3
node-14-s-2 ::= ws "," ws "\"num1\"" ws ":" ws node-15 node-14-s-3
node-14-s-3 ::= ""
node-14 ::= "{" ws node-14-s-0 ws "}"
node-12-s-0 ::= "\"name\"" ws ":" ws node-13 node-12-s-1 | "\"parameters\"" ws ":" ws node-14 node-12-s-2
node-12-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-14 node-12-s-3
node-12-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-13 node-12-s-3
node-12-s-3 ::= ""
node-12 ::= "{" ws node-12-s-0 ws "}"
node-1 ::= node-2 | node-7 | node-12
call ::= node-1
