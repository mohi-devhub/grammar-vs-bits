root ::= ws ("NO_CALL" | call | "[" ws call (ws "," ws call)* ws "]") ws
ws ::= [ \t\n\r]*
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
integer ::= "-"? ("0" | [1-9] [0-9]*)
boolean ::= "true" | "false"
null ::= "null"
value ::= string | number | boolean | null | any-object | any-array
any-object ::= "{" ws (string ws ":" ws value (ws "," ws string ws ":" ws value)*)? ws "}"
any-array ::= "[" ws (value (ws "," ws value)*)? ws "]"
node-3 ::= "\"get_case_info\""
node-5 ::= string
node-6 ::= string
node-7 ::= string
node-4-s-0 ::= "\"docket\"" ws ":" ws node-5 node-4-s-1 | "\"court\"" ws ":" ws node-6 node-4-s-2 | "\"info_type\"" ws ":" ws node-7 node-4-s-4
node-4-s-1 ::= ws "," ws "\"court\"" ws ":" ws node-6 node-4-s-3 | ws "," ws "\"info_type\"" ws ":" ws node-7 node-4-s-5
node-4-s-2 ::= ws "," ws "\"docket\"" ws ":" ws node-5 node-4-s-3 | ws "," ws "\"info_type\"" ws ":" ws node-7 node-4-s-6
node-4-s-3 ::= ws "," ws "\"info_type\"" ws ":" ws node-7 node-4-s-7
node-4-s-4 ::= ws "," ws "\"docket\"" ws ":" ws node-5 node-4-s-5 | ws "," ws "\"court\"" ws ":" ws node-6 node-4-s-6
node-4-s-5 ::= ws "," ws "\"court\"" ws ":" ws node-6 node-4-s-7
node-4-s-6 ::= ws "," ws "\"docket\"" ws ":" ws node-5 node-4-s-7
node-4-s-7 ::= ""
node-4 ::= "{" ws node-4-s-0 ws "}"
node-2-s-0 ::= "\"name\"" ws ":" ws node-3 node-2-s-1 | "\"parameters\"" ws ":" ws node-4 node-2-s-2
node-2-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-4 node-2-s-3
node-2-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-3 node-2-s-3
node-2-s-3 ::= ""
node-2 ::= "{" ws node-2-s-0 ws "}"
node-9 ::= "\"calculate_triangle_area\""
node-11 ::= number
node-12 ::= number
node-13 ::= string
node-10-s-0 ::= "\"base\"" ws ":" ws node-11 node-10-s-1 | "\"height\"" ws ":" ws node-12 node-10-s-2 | "\"unit\"" ws ":" ws node-13 node-10-s-4
node-10-s-1 ::= ws "," ws "\"height\"" ws ":" ws node-12 node-10-s-3 | ws "," ws "\"unit\"" ws ":" ws node-13 node-10-s-5
node-10-s-2 ::= ws "," ws "\"base\"" ws ":" ws node-11 node-10-s-3 | ws "," ws "\"unit\"" ws ":" ws node-13 node-10-s-6
node-10-s-3 ::= "" | ws "," ws "\"unit\"" ws ":" ws node-13 node-10-s-7
node-10-s-4 ::= ws "," ws "\"base\"" ws ":" ws node-11 node-10-s-5 | ws "," ws "\"height\"" ws ":" ws node-12 node-10-s-6
node-10-s-5 ::= ws "," ws "\"height\"" ws ":" ws node-12 node-10-s-7
node-10-s-6 ::= ws "," ws "\"base\"" ws ":" ws node-11 node-10-s-7
node-10-s-7 ::= ""
node-10 ::= "{" ws node-10-s-0 ws "}"
node-8-s-0 ::= "\"name\"" ws ":" ws node-9 node-8-s-1 | "\"parameters\"" ws ":" ws node-10 node-8-s-2
node-8-s-1 ::= ws "," ws "\"parameters\"" ws ":" ws node-10 node-8-s-3
node-8-s-2 ::= ws "," ws "\"name\"" ws ":" ws node-9 node-8-s-3
node-8-s-3 ::= ""
node-8 ::= "{" ws node-8-s-0 ws "}"
node-1 ::= node-2 | node-8
call ::= node-1
